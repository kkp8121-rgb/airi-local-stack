ollama-proxy/eval/broadcast_sim/first_broadcast_v1.json text eol=lf
ollama-proxy/eval/broadcast_sim/second_broadcast_v1.json text eol=lf
# Deterministic SFT exports are pinned by raw SHA-256 and must survive Windows checkout.
ollama-proxy/training/seed/airi_broadcast_continuity_v4.jsonl text eol=lf
ollama-proxy/training/seed/airi_broadcast_continuity_v4_chat.jsonl text eol=lf
# Whole training corpus tree is read raw-byte for SHA-256 determinism gates (behavior_v2/continuity_v3/v4 seeds, cards, schemas) — closes the gap the two entries above only partially covered; any CRLF smudge under Windows autocrlf breaks the hash pins.
ollama-proxy/training/**/*.jsonl text eol=lf
ollama-proxy/training/**/*.json text eol=lf
