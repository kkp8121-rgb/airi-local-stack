--- /dev/null
+++ b/packages/stage-ui/src/stores/providers/local-stt/stream-transcription.ts
@@ -0,0 +1,144 @@
+import type { CommonRequestOptions } from '@xsai/shared'
+import type { StreamTranscriptionDelta, StreamTranscriptionResult } from '@xsai/stream-transcription'
+
+type AudioChunk = ArrayBuffer | ArrayBufferView
+
+export interface LocalSttStreamOptions {
+  baseURL?: CommonRequestOptions['baseURL']
+  inputAudioStream?: ReadableStream<AudioChunk>
+  abortSignal?: AbortSignal
+  language?: string
+}
+
+export interface LocalSttStreamResult extends StreamTranscriptionResult {
+  /** Interim captions are intentionally separate from final text/chat deltas. */
+  partialStream: ReadableStream<string>
+}
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  let reject!: (reason?: unknown) => void
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej })
+  return { promise, reject, resolve }
+}
+
+function websocketUrl(baseURL?: CommonRequestOptions['baseURL']) {
+  const url = new URL(baseURL instanceof URL ? baseURL : (typeof baseURL === 'string' ? baseURL : 'http://127.0.0.1:2026/v1/'))
+  if (!['localhost', '127.0.0.1', '[::1]', '::1'].includes(url.hostname.toLowerCase()))
+    throw new TypeError('Local streaming transcription requires a loopback base URL.')
+  if (url.protocol === 'https:') url.protocol = 'wss:'
+  else url.protocol = 'ws:'
+  url.pathname = `${url.pathname.replace(/\/$/, '')}/audio/transcriptions/stream`.replace(/\/v1\/v1\//, '/v1/')
+  return url.toString()
+}
+
+function base64(chunk: AudioChunk) {
+  const bytes = chunk instanceof ArrayBuffer
+    ? new Uint8Array(chunk)
+    : new Uint8Array(chunk.buffer, chunk.byteOffset, chunk.byteLength)
+  let binary = ''
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return btoa(binary)
+}
+
+/** Loopback-only AIRI STT websocket executor. PCM16 is supplied by hearing.ts. */
+export function streamLocalSttTranscription(options: LocalSttStreamOptions): LocalSttStreamResult {
+  if (!options.inputAudioStream) throw new TypeError('Audio stream is required for local streaming transcription.')
+  const result = deferred<string>()
+  let textController!: ReadableStreamDefaultController<string>
+  let fullController!: ReadableStreamDefaultController<StreamTranscriptionDelta>
+  let partialController!: ReadableStreamDefaultController<string>
+  const textStream = new ReadableStream<string>({ start: c => { textController = c } })
+  const fullStream = new ReadableStream<StreamTranscriptionDelta>({ start: c => { fullController = c } })
+  const partialStream = new ReadableStream<string>({ start: c => { partialController = c } })
+  const socket = new WebSocket(websocketUrl(options.baseURL))
+  let reader: ReadableStreamDefaultReader<AudioChunk> | undefined
+  let finalText = ''
+  let finished = false
+
+  const releaseInput = (reason?: unknown) => {
+    const currentReader = reader
+    reader = undefined
+    if (!currentReader) return
+    void currentReader.cancel(reason).catch(() => {}).finally(() => currentReader.releaseLock())
+  }
+
+  const closeSocket = () => {
+    if (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING)
+      socket.close()
+  }
+
+  const finish = (error?: unknown) => {
+    if (finished) return
+    finished = true
+    releaseInput(error)
+    if (error) {
+      textController.error(error); fullController.error(error); partialController.error(error); result.reject(error)
+    } else {
+      textController.close(); fullController.close(); partialController.close(); result.resolve(finalText)
+    }
+  }
+
+  socket.onopen = async () => {
+    try {
+      if (finished || options.abortSignal?.aborted) return
+      socket.send(JSON.stringify({ type: 'start', format: 'pcm16', sample_rate: 16000, language: options.language }))
+      const activeReader = options.inputAudioStream!.getReader()
+      reader = activeReader
+      while (!options.abortSignal?.aborted) {
+        if (socket.readyState !== WebSocket.OPEN) break
+        const { done, value } = await activeReader.read()
+        if (done) break
+        if (value) {
+          // Do not let a slow loopback decoder turn an unlimited microphone
+          // stream into renderer memory pressure.
+          while (socket.bufferedAmount > 256 * 1024) {
+            if (options.abortSignal?.aborted) break
+            await new Promise(resolve => setTimeout(resolve, 10))
+          }
+          if (!options.abortSignal?.aborted && socket.readyState === WebSocket.OPEN)
+            socket.send(JSON.stringify({ type: 'pcm16', data: base64(value) }))
+        }
+      }
+      releaseInput()
+      if (!finished && socket.readyState === WebSocket.OPEN)
+        socket.send(JSON.stringify({ type: options.abortSignal?.aborted ? 'cancel' : 'end' }))
+    } catch (error) { finish(error); closeSocket() }
+  }
+  socket.onmessage = ({ data }) => {
+    if (finished) return
+    let event: { type?: string, delta?: string, text?: string, message?: string }
+    try {
+      event = JSON.parse(String(data)) as typeof event
+    } catch {
+      finish(new Error('Local streaming transcription sent malformed JSON.'))
+      closeSocket()
+      return
+    }
+    if (!event || typeof event !== 'object') return
+    if (event.type === 'partial' && event.text) partialController.enqueue(event.text)
+    if (event.type === 'final') {
+      finalText = event.text ?? ''
+      if (finalText) {
+        const delta: StreamTranscriptionDelta = { type: 'transcript.text.delta', delta: finalText }
+        fullController.enqueue(delta); textController.enqueue(finalText)
+      }
+      fullController.enqueue({ type: 'transcript.text.done', delta: '' })
+      finish(); closeSocket()
+    }
+    if (event.type === 'error') {
+      finish(new Error(event.message ?? 'Local streaming transcription failed.'))
+      closeSocket()
+    }
+  }
+  socket.onerror = () => { finish(new Error('Local streaming transcription websocket failed.')); closeSocket() }
+  socket.onclose = () => { if (!finished) finish(options.abortSignal?.reason ?? new DOMException('Closed', 'AbortError')) }
+  const abortStream = () => {
+    if (!finished && socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify({ type: 'cancel' }))
+    finish(options.abortSignal?.reason ?? new DOMException('Aborted', 'AbortError'))
+    closeSocket()
+  }
+  options.abortSignal?.addEventListener('abort', abortStream, { once: true })
+  if (options.abortSignal?.aborted) abortStream()
+  return { fullStream, partialStream, text: result.promise, textStream }
+}
