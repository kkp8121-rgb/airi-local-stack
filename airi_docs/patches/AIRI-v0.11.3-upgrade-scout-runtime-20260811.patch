new file mode 100644
index 00000000..1c517548
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/incremental-wav.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from 'vitest'
+
+import type { PcmWavChunk } from './incremental-wav'
+import { IncrementalPcmWavParser, pcm16ToFloat32 } from './incremental-wav'
+
+function wav(chunks: Array<{ id: string, bytes: number[] }>) {
+  const payload = chunks.flatMap(({ id, bytes }) => [...id].map(char => char.charCodeAt(0)).concat([bytes.length, 0, 0, 0], bytes, bytes.length % 2 ? [0] : []))
+  return new Uint8Array([...('RIFFWAVE')].map(char => char.charCodeAt(0)).slice(0, 4).concat([payload.length + 4, 0, 0, 0], [...'WAVE'].map(char => char.charCodeAt(0)), payload))
+}
+const fmt = [1, 0, 2, 0, 0x44, 0xac, 0, 0, 0x10, 0xb1, 2, 0, 4, 0, 16, 0]
+
+describe('IncrementalPcmWavParser', () => {
+  it('parses headers and PCM split across arbitrary network boundaries', () => {
+    const source = wav([{ id: 'fmt ', bytes: fmt }, { id: 'JUNK', bytes: [1, 2, 3] }, { id: 'data', bytes: [0, 0, 0, 128, 255, 127, 0, 0] }])
+    const parser = new IncrementalPcmWavParser()
+    const out = source.reduce<PcmWavChunk[]>((all, _byte, index) => all.concat(parser.push(source.slice(index, index + 1))), [])
+    expect(parser.parsedFormat).toEqual({ channels: 2, sampleRate: 44100 })
+    expect(out.flatMap(chunk => [...chunk.samples])).toEqual([0, -32768, 32767, 0])
+  })
+
+  it('streams PCM after a zero-length data header without exposing WAV headers', () => {
+    const header = wav([{ id: 'fmt ', bytes: fmt }, { id: 'data', bytes: [] }])
+    const streamedPcm = new Uint8Array([0, 0, 0, 128, 255, 127, 0, 0])
+    const source = new Uint8Array(header.length + streamedPcm.length)
+    source.set(header)
+    source.set(streamedPcm, header.length)
+    const parser = new IncrementalPcmWavParser()
+    const out = source.reduce<PcmWavChunk[]>((all, _byte, index) => all.concat(parser.push(source.slice(index, index + 1))), [])
+
+    expect(out.flatMap(chunk => [...chunk.samples])).toEqual([0, -32768, 32767, 0])
+    expect(parser.supported).toBe(true)
+  })
+
+  it('does not emit audio for a genuinely empty WAV', () => {
+    const parser = new IncrementalPcmWavParser()
+
+    expect(parser.push(wav([{ id: 'fmt ', bytes: fmt }, { id: 'data', bytes: [] }]))).toEqual([])
+    expect(parser.supported).toBe(true)
+  })
+
+  it('rejects compressed input without exposing payload as PCM', () => {
+    const parser = new IncrementalPcmWavParser()
+    const source = wav([{ id: 'fmt ', bytes: [3, 0, ...fmt.slice(2)] }, { id: 'data', bytes: [1, 2, 3, 4] }])
+    expect(parser.push(source)).toEqual([])
+    expect(parser.supported).toBe(false)
+  })
+})
+
+describe('pcm16ToFloat32', () => {
+  it('converts signed PCM16 without changing interleaved channel order', () => {
+    expect([...pcm16ToFloat32(new Int16Array([-32768, 0, 32767, -16384]))]).toEqual([-1, 0, 32767 / 32768, -0.5])
+  })
+})
diff --git a/packages/stage-ui/src/libs/speech/incremental-wav.ts b/packages/stage-ui/src/libs/speech/incremental-wav.ts
new file mode 100644
index 00000000..b484ff84
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/incremental-wav.ts
@@ -0,0 +1,141 @@
+export interface PcmWavFormat {
+  sampleRate: number
+  channels: 1 | 2
+}
+
+export interface PcmWavChunk {
+  format: PcmWavFormat
+  samples: Int16Array
+}
+
+/** Incrementally extracts PCM16 WAV data without ever exposing RIFF headers as audio samples. */
+export class IncrementalPcmWavParser {
+  private bytes = new Uint8Array()
+  private offset = 0
+  private format: PcmWavFormat | undefined
+  private containerRead = false
+  private remainingDataBytes = 0
+  // Some streaming encoders send a canonical empty data chunk header, then append
+  // PCM frames over the transport. Treat that particular header as open-ended.
+  private unboundedData = false
+  private rejected = false
+
+  get supported() { return !this.rejected }
+  get parsedFormat() { return this.format }
+  get hasData() { return this.unboundedData || this.remainingDataBytes > 0 }
+
+  push(chunk: Uint8Array): PcmWavChunk[] {
+    if (this.rejected)
+      return []
+    this.append(chunk)
+    const output: PcmWavChunk[] = []
+    while (true) {
+      if (!this.format && !this.readContainerAndFormat())
+        break
+      if (!this.unboundedData && this.remainingDataBytes === 0 && !this.readNextChunk())
+        break
+      if (this.unboundedData || this.remainingDataBytes > 0) {
+        const available = this.unboundedData
+          ? this.bytes.length - this.offset
+          : Math.min(this.remainingDataBytes, this.bytes.length - this.offset)
+        // PCM16 samples must never be split; retain one trailing byte for the next network chunk.
+        const usable = available - (available % 2)
+        if (usable === 0)
+          break
+        const pcmBytes = this.bytes.slice(this.offset, this.offset + usable)
+        this.offset += usable
+        if (!this.unboundedData)
+          this.remainingDataBytes -= usable
+        output.push({ format: this.format!, samples: new Int16Array(pcmBytes.buffer) })
+        continue
+      }
+    }
+    this.compact()
+    return output
+  }
+
+  private append(chunk: Uint8Array) {
+    const remaining = this.bytes.slice(this.offset)
+    this.bytes = new Uint8Array(remaining.length + chunk.length)
+    this.bytes.set(remaining)
+    this.bytes.set(chunk, remaining.length)
+    this.offset = 0
+  }
+
+  private readContainerAndFormat() {
+    if (this.containerRead)
+      return this.readNextChunk()
+    if (this.bytes.length - this.offset < 12)
+      return false
+    const view = new DataView(this.bytes.buffer, this.bytes.byteOffset + this.offset)
+    if (this.readAscii(this.offset, 4) !== 'RIFF' || this.readAscii(this.offset + 8, 4) !== 'WAVE') {
+      this.rejected = true
+      return false
+    }
+    // RIFF's declared length only applies to the container; transport may still split it arbitrarily.
+    view.getUint32(4, true)
+    this.offset += 12
+    this.containerRead = true
+    return this.readNextChunk()
+  }
+
+  private readNextChunk() {
+    while (this.bytes.length - this.offset >= 8) {
+      const id = this.readAscii(this.offset, 4)
+      const size = new DataView(this.bytes.buffer, this.bytes.byteOffset + this.offset).getUint32(4, true)
+      const paddedSize = size + (size % 2)
+      if (id === 'data') {
+        if (!this.format) {
+          this.rejected = true
+          return false
+        }
+        this.offset += 8
+        this.remainingDataBytes = size
+        this.unboundedData = size === 0
+        return true
+      }
+      if (this.bytes.length - this.offset < 8 + paddedSize)
+        return false
+      const dataOffset = this.offset + 8
+      if (id === 'fmt ') {
+        if (size < 16) {
+          this.rejected = true
+          return false
+        }
+        const view = new DataView(this.bytes.buffer, this.bytes.byteOffset + dataOffset, size)
+        const encoding = view.getUint16(0, true)
+        const channels = view.getUint16(2, true)
+        const sampleRate = view.getUint32(4, true)
+        const bitsPerSample = view.getUint16(14, true)
+        if (encoding !== 1 || (channels !== 1 && channels !== 2) || bitsPerSample !== 16 || sampleRate === 0) {
+          this.rejected = true
+          return false
+        }
+        this.format = { channels, sampleRate }
+        this.offset += 8 + paddedSize
+        continue
+      }
+      this.offset += 8 + paddedSize
+    }
+    return false
+  }
+
+  private readAscii(offset: number, length: number) {
+    return String.fromCharCode(...this.bytes.slice(offset, offset + length))
+  }
+
+  private compact() {
+    if (this.offset === 0)
+      return
+    this.bytes = this.bytes.slice(this.offset)
+    this.offset = 0
+  }
+}
+
+/** Converts signed interleaved PCM16 samples into Web Audio's float range. */
+export function pcm16ToFloat32(samples: Int16Array) {
+  const output = new Float32Array(samples.length)
+  for (let index = 0; index < samples.length; index += 1)
+    output[index] = Math.max(-1, samples[index] / 32768)
+  return output
+}
