+import type { StreamingPlaybackAudio } from '@proj-airi/pipelines-audio'
+
+import { readLocalWavResponse } from './local-wav-response'
+import { createPcmWorkletPlayback } from './pcm-worklet'
+
+export interface LocalWavStreamingPlaybackOptions {
+  audioContext: AudioContext
+  request: Parameters<typeof readLocalWavResponse>[0]
+  /** Preserves decodeAudioData playback when the local response is not PCM WAV. */
+  playFallback: (audio: ArrayBuffer, signal: AbortSignal, onAudibleStart: () => void) => Promise<void>
+}
+
+/**
+ * Creates one queue-owned streamed playback item. It is inert until the
+ * playback manager reaches it, so network/audio work follows queue order.
+ */
+export function createLocalWavStreamingPlayback(options: LocalWavStreamingPlaybackOptions): StreamingPlaybackAudio {
+  return {
+    kind: 'streaming-playback',
+    async start(signal, onAudibleStart) {
+      let worklet: ReturnType<typeof createPcmWorkletPlayback> | undefined
+      let audible = false
+      const abort = () => worklet?.abort()
+      signal.addEventListener('abort', abort, { once: true })
+      try {
+        const result = await readLocalWavResponse(options.request, {
+          signal,
+          onPcm: async (chunk) => {
+            if (signal.aborted)
+              return
+            if (!worklet) {
+              worklet = createPcmWorkletPlayback(options.audioContext, chunk.format)
+              await worklet.ready
+            }
+            if (signal.aborted)
+              return
+            if (worklet.writePcm16(chunk.samples) && !audible) {
+              audible = true
+              onAudibleStart()
+            }
+          },
+        })
+        if (signal.aborted)
+          return
+        if (result.streamed) {
+          worklet?.end()
+          await worklet?.finished
+          return
+        }
+        if (result.fallback)
+          await options.playFallback(result.fallback, signal, onAudibleStart)
+      }
+      finally {
+        signal.removeEventListener('abort', abort)
+      }
+    },
+  }
+}
