+import { describe, expect, it } from 'vitest'
+
+import {
+  VAD_MIN_SILENCE_EXPERIMENTS,
+  canPromoteVadMinSilenceCandidate,
+  summarizeVadExperiment,
+} from './voice-input-vad-experiment'
+
+describe('VAD min-silence experiment harness', () => {
+  it('keeps 450ms as the production configuration and exposes 300ms only as a candidate', () => {
+    expect(VAD_MIN_SILENCE_EXPERIMENTS.production.minSilenceDurationMs).toBe(450)
+    expect(VAD_MIN_SILENCE_EXPERIMENTS.candidate.minSilenceDurationMs).toBe(300)
+  })
+
+  it('detects a synthetic split and false final before a resumed utterance', () => {
+    const measurement = summarizeVadExperiment(
+      'candidate',
+      'proper-noun-pause',
+      'AIRI Kizuna AI',
+      'AIRI Kizuna AI',
+      [
+        { atMs: 0, type: 'speech-start' },
+        { atMs: 300, type: 'speech-ready' },
+        { atMs: 340, type: 'speech-start' },
+        { atMs: 900, type: 'speech-ready' },
+      ],
+    )
+
+    expect(measurement.split).toBe(true)
+    expect(measurement.falseFinal).toBe(true)
+    expect(measurement.properNounPreserved).toBe(true)
+  })
+
+  it('does not promote 300ms until twenty mic measurements pass split, proper-noun, and error gates', () => {
+    const passing = summarizeVadExperiment(
+      'candidate',
+      'complete-utterance',
+      'AIRI Kizuna AI',
+      'AIRI Kizuna AI',
+      [
+        { atMs: 0, type: 'speech-start' },
+        { atMs: 900, type: 'speech-ready' },
+      ],
+    )
+
+    expect(canPromoteVadMinSilenceCandidate(Array.from({ length: 19 }, () => passing))).toBe(false)
+    expect(canPromoteVadMinSilenceCandidate(Array.from({ length: 20 }, () => passing))).toBe(true)
+    expect(canPromoteVadMinSilenceCandidate([passing, {
+      ...passing,
+      split: true,
+    }, ...Array.from({ length: 18 }, () => passing)])).toBe(false)
+  })
+})
diff --git a/packages/stage-ui/src/composables/audio/voice-input-vad-experiment.ts b/packages/stage-ui/src/composables/audio/voice-input-vad-experiment.ts
