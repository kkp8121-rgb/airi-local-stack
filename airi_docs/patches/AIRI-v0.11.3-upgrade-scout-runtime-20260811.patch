@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest'
+
+import { audioInteractionConstraints, createBargeInConfirmation, shouldBlockVoiceTransmission } from './audio-interaction-mode'
+
+describe('audio interaction modes', () => {
+  it('allows full duplex and enables AEC only for speakers', () => {
+    expect(shouldBlockVoiceTransmission('half-duplex', true)).toBe(true)
+    expect(shouldBlockVoiceTransmission('headphones-full-duplex', true)).toBe(false)
+    expect(audioInteractionConstraints('headphones-full-duplex')).toEqual({ echoCancellation: false, noiseSuppression: false, autoGainControl: false })
+    expect(audioInteractionConstraints('speakers-aec')).toEqual({ echoCancellation: true, noiseSuppression: false, autoGainControl: false })
+  })
+})
+
+describe('createBargeInConfirmation', () => {
+  it('rejects a pop and confirms sustained speech within the bounded window', () => {
+    const confirmation = createBargeInConfirmation(300)
+    expect(confirmation.observe(1000)).toBe(false)
+    expect(confirmation.observe(1250)).toBe(true)
+    expect(confirmation.observe(2000)).toBe(false)
+    expect(confirmation.observe(2350)).toBe(false)
+  })
+})
diff --git a/apps/stage-tamagotchi/src/renderer/utils/audio-interaction-mode.ts b/apps/stage-tamagotchi/src/renderer/utils/audio-interaction-mode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7cad5dbb4ab1cbd46aa9558cb46ca63ceb9465ca
--- /dev/null
+++ b/apps/stage-tamagotchi/src/renderer/utils/audio-interaction-mode.ts
@@ -0,0 +1,27 @@
+export type AudioInteractionMode = 'half-duplex' | 'headphones-full-duplex' | 'speakers-aec'
+
+export const defaultAudioInteractionMode: AudioInteractionMode = 'half-duplex'
+
+export function audioInteractionConstraints(mode: AudioInteractionMode) {
+  return { echoCancellation: mode === 'speakers-aec', noiseSuppression: false, autoGainControl: false }
+}
+
+export function shouldBlockVoiceTransmission(mode: AudioInteractionMode, assistantPlaybackActive: boolean) {
+  return mode === 'half-duplex' && assistantPlaybackActive
+}
+
+/** Requires two VAD speech starts inside a 300ms confirmation window. */
+export function createBargeInConfirmation(windowMs = 300) {
+  let firstSpeechAt: number | undefined
+  return {
+    observe(now: number) {
+      if (firstSpeechAt === undefined || now - firstSpeechAt > windowMs) {
+        firstSpeechAt = now
+        return false
+      }
+      firstSpeechAt = undefined
+      return true
+    },
+    reset() { firstSpeechAt = undefined },
+  }
+}
diff --git a/apps/stage-tamagotchi/src/renderer/utils/voice-transcript-ingestion-guard.test.ts b/apps/stage-tamagotchi/src/renderer/utils/voice-transcript-ingestion-guard.test.ts
