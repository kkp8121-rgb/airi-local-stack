index 00000000..3db650aa
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/pcm-resampler.ts
@@ -0,0 +1,97 @@
+/**
+ * Stateful linear PCM resampler for interleaved mono or stereo Web Audio
+ * samples. It retains one source frame between writes so arbitrary network
+ * chunk boundaries produce the same audio as a single write.
+ */
+export class PcmStreamResampler {
+  private pending = new Float32Array(0)
+  private lastFrame = new Float32Array(0)
+  private inputFrames = 0
+  private outputFrames = 0
+
+  constructor(
+    readonly sourceRate: number,
+    readonly targetRate: number,
+    readonly channels: 1 | 2,
+  ) {
+    if (!Number.isFinite(sourceRate) || !Number.isFinite(targetRate) || sourceRate <= 0 || targetRate <= 0)
+      throw new Error('PCM sample rates must be positive')
+  }
+
+  push(samples: Int16Array | Float32Array) {
+    const floats = samples instanceof Int16Array ? pcm16ToFloat32(samples) : samples
+    const combined = new Float32Array(this.pending.length + floats.length)
+    combined.set(this.pending)
+    combined.set(floats, this.pending.length)
+    const usable = combined.length - (combined.length % this.channels)
+    this.pending = combined.slice(usable)
+    if (usable === 0)
+      return new Float32Array(0)
+    const frames = combined.slice(0, usable)
+    if (this.sourceRate === this.targetRate)
+      return this.pushIdentity(frames)
+    return this.pushResampled(frames, false)
+  }
+
+  finish() {
+    // A partial interleaved frame is deliberately discarded: emitting it would
+    // shift the following channel and corrupt stereo playback.
+    this.pending = new Float32Array(0)
+    if (this.sourceRate === this.targetRate)
+      return new Float32Array(0)
+    return this.pushResampled(new Float32Array(0), true)
+  }
+
+  private pushIdentity(frames: Float32Array) {
+    this.inputFrames += frames.length / this.channels
+    this.outputFrames += frames.length / this.channels
+    return frames
+  }
+
+  private pushResampled(frames: Float32Array, final: boolean) {
+    const incomingFrames = frames.length / this.channels
+    const firstFrame = this.inputFrames === 0
+      ? 0
+      : this.inputFrames - 1
+    const source = this.inputFrames === 0
+      ? frames
+      : this.join(this.lastFrame, frames)
+    this.inputFrames += incomingFrames
+    if (incomingFrames > 0)
+      this.lastFrame = frames.slice(frames.length - this.channels)
+    if (source.length === 0)
+      return new Float32Array(0)
+
+    const output: number[] = []
+    while (true) {
+      const position = this.outputFrames * this.sourceRate / this.targetRate
+      if (position >= this.inputFrames || (!final && position >= this.inputFrames - 1))
+        break
+      const local = position - firstFrame
+      const lower = Math.floor(local)
+      const fraction = local - lower
+      const upper = Math.min(lower + 1, source.length / this.channels - 1)
+      for (let channel = 0; channel < this.channels; channel += 1) {
+        const a = source[lower * this.channels + channel]
+        const b = source[upper * this.channels + channel]
+        output.push(a + (b - a) * fraction)
+      }
+      this.outputFrames += 1
+    }
+    return new Float32Array(output)
+  }
+
+  private join(left: Float32Array, right: Float32Array) {
+    const output = new Float32Array(left.length + right.length)
+    output.set(left)
+    output.set(right, left.length)
+    return output
+  }
+}
+
+function pcm16ToFloat32(samples: Int16Array) {
+  const output = new Float32Array(samples.length)
+  for (let index = 0; index < samples.length; index += 1)
+    output[index] = Math.max(-1, samples[index] / 32768)
+  return output
+}
