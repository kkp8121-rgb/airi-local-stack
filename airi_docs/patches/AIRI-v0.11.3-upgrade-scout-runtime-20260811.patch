+import { describe, expect, it } from 'vitest'
+
+import { PcmRingBuffer } from './pcm-ring'
+
+describe('PcmRingBuffer', () => {
+  it('applies bounded backpressure and drops all queued audio on abort', () => {
+    const ring = new PcmRingBuffer(4)
+    expect(ring.write(new Float32Array([1, 2, 3]))).toBe(true)
+    expect(ring.write(new Float32Array([4, 5]))).toBe(false)
+    expect([...ring.read(2)]).toEqual([1, 2])
+    expect(ring.write(new Float32Array([4, 5]))).toBe(true)
+    ring.flush(true)
