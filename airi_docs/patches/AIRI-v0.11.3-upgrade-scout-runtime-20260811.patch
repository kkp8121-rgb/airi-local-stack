index 0000000000000000000000000000000000000000..fad8607c4d2cfaee6f724041e68bf6c64e6960e6
--- /dev/null
+++ b/apps/stage-tamagotchi/src/renderer/utils/voice-transcript-ingestion-guard.ts
@@ -0,0 +1,16 @@
+/**
+ * Runs user-text side effects only when a transcript is not a recently played
+ * assistant utterance. Keeping this boundary around the callbacks ensures an
+ * echo cannot reach captions, chat, journal, or memory ingestion indirectly.
+ */
+export function acceptVoiceTranscript(
+  text: string,
+  isAssistantSpeechEcho: (text: string) => boolean,
+  ingest: () => void,
+) {
+  if (isAssistantSpeechEcho(text))
+    return false
+
+  ingest()
+  return true
+}
