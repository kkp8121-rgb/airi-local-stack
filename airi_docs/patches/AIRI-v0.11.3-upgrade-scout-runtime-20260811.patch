+import { describe, expect, it, vi } from 'vitest'
+
+import { BoundedFallbackPrefix, readLocalWavResponse } from './local-wav-response'
+
+function progressiveWavHeader() {
+  const fmt = new Uint8Array([1, 0, 1, 0, 0, 125, 0, 0, 0, 250, 0, 0, 2, 0, 16, 0])
+  return new Uint8Array([...('RIFF').split('').map(char => char.charCodeAt(0)), 36, 0, 0, 0, ...('WAVEfmt ').split('').map(char => char.charCodeAt(0)), 16, 0, 0, 0, ...fmt, ...('data').split('').map(char => char.charCodeAt(0)), 0, 0, 0, 0])
+}
+
+describe('readLocalWavResponse', () => {
+  it('treats a progressive zero-sized WAV data header as streamed without a decoder fallback', async () => {
+    const result = await readLocalWavResponse({
+      url: 'http://127.0.0.1/tts',
+      body: '',
+      fetch: async () => new Response(progressiveWavHeader()),
+    }, { signal: new AbortController().signal, onPcm: () => {} })
+    expect(result).toMatchObject({ streamed: true })
+    expect(result.fallback).toBeUndefined()
+  })
+
+  it('releases the fallback prefix during a sustained recognized WAV stream', async () => {
+    let sent = 0
+    const chunks = 256
+    const body = new ReadableStream<Uint8Array>({
+      pull(controller) {
+        if (sent === 0)
+          controller.enqueue(progressiveWavHeader())
+        else if (sent <= chunks)
+          controller.enqueue(new Uint8Array(4096))
+        else
+          controller.close()
+        sent += 1
+      },
+    })
+    const onPcm = vi.fn()
+    const result = await readLocalWavResponse({ url: 'http://127.0.0.1/tts', body: '', fetch: async () => new Response(body) }, { signal: new AbortController().signal, onPcm })
+    expect(result).toMatchObject({ streamed: true })
+    expect(result.fallback).toBeUndefined()
+    expect(onPcm).toHaveBeenCalledTimes(chunks)
+  })
+
+  it('bounds the retained pre-recognition prefix', () => {
+    const prefix = new BoundedFallbackPrefix()
+    prefix.append(new Uint8Array(512 * 1024 + 1))
+    expect(prefix.toArrayBuffer()).toBeUndefined()
+  })
+
+  it('fails explicitly when an unsupported response exceeds the bounded fallback prefix', async () => {
+    await expect(readLocalWavResponse({
+      url: 'http://127.0.0.1/tts',
+      body: '',
+      fetch: async () => new Response(new Uint8Array(512 * 1024 + 1)),
+    }, { signal: new AbortController().signal, onPcm: () => {} })).rejects.toThrow('Unsupported local speech response exceeds 524288-byte fallback limit')
+  })
+
+  it('passes abort through fetch and never emits PCM after cancellation', async () => {
+    const controller = new AbortController()
+    controller.abort()
+    const onPcm = vi.fn()
+    const fetch = vi.fn(async (_url: string | URL, init?: RequestInit) => {
+      expect(init?.signal).toBe(controller.signal)
+      return new Response(new ReadableStream({}), { status: 200 })
+    })
+    const response = await readLocalWavResponse({ url: 'http://127.0.0.1/tts', body: '', fetch }, {
+      signal: controller.signal,
+      onPcm,
+    })
+    expect(response.streamed).toBe(false)
+    expect(response.fallback).toBeUndefined()
+    expect(onPcm).not.toHaveBeenCalled()
+  })
+
+  it('returns non-WAV payload for the full-buffer decoder fallback', async () => {
+    const response = await readLocalWavResponse({
+      url: 'http://127.0.0.1/tts',
+      body: '',
+      fetch: async () => new Response(new Uint8Array([1, 2, 3])),
+    }, { signal: new AbortController().signal, onPcm: () => {} })
+    expect(response.streamed).toBe(false)
+    expect(response.fallback).toEqual(new Uint8Array([1, 2, 3]).buffer)
+  })
+
+  it('does not emit a late PCM event after aborting a pending stream read', async () => {
+    const controller = new AbortController()
+    let release!: (value: ReadableStreamReadResult<Uint8Array>) => void
+    const body = new ReadableStream<Uint8Array>({
+      pull(controller) {
+        release = value => {
+          if (value.done)
+            controller.close()
+          else
+            controller.enqueue(value.value)
+        }
+      },
+    })
+    const onPcm = vi.fn()
+    const pending = readLocalWavResponse({ url: 'http://127.0.0.1/tts', body: '', fetch: async () => new Response(body) }, { signal: controller.signal, onPcm })
+    await Promise.resolve()
+    controller.abort()
+    release({ done: true, value: undefined })
+    await pending
+    expect(onPcm).not.toHaveBeenCalled()
+  })
+
+  it('preserves the resolved speech endpoint, headers, and body', async () => {
+    const fetch = vi.fn(async () => new Response(new Uint8Array([1])))
+    await readLocalWavResponse({
+      url: 'http://127.0.0.1:5000/v1/audio/speech',
+      headers: {
+        Authorization: 'Bearer local-key',
+        'Content-Type': 'application/json',
+        'X-Airi-Chat-Round-Id': 'round-1',
+      },
+      body: '{"input":"hello","response_format":"wav"}',
+      fetch,
+    }, { signal: new AbortController().signal, onPcm: () => {} })
+
+    expect(fetch).toHaveBeenCalledWith(
+      new URL('http://127.0.0.1:5000/v1/audio/speech'),
+      expect.objectContaining({
+        body: '{"input":"hello","response_format":"wav"}',
+        headers: expect.objectContaining({
+          Authorization: 'Bearer local-key',
+          'Content-Type': 'application/json',
+          'X-Airi-Chat-Round-Id': 'round-1',
+        }),
+        method: 'POST',
+      }),
+    )
+  })
+})
diff --git a/packages/stage-ui/src/libs/speech/local-wav-response.ts b/packages/stage-ui/src/libs/speech/local-wav-response.ts
