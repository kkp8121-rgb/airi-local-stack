index 0000000000000000000000000000000000000000..65af8764729fa042ee9068fb7c42c6c173a50446
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/text-self-echo.ts
@@ -0,0 +1,115 @@
+export interface AssistantSpeechTextEchoGuardOptions {
+  /** Maximum number of played TTS fragments retained. @default 16 */
+  capacity?: number
+  /** How long a played fragment may suppress a matching transcript, in milliseconds. @default 6000 */
+  ttlMs?: number
+}
+
+interface PlayedText {
+  text: string
+  playedAt: number
+}
+
+const minimumComparableLength = 6
+const defaultCapacity = 16
+const defaultTtlMs = 6_000
+
+/**
+ * Normalizes speech text before comparison.
+ *
+ * Before:
+ * - "오늘 날씨를 알려줘!"
+ *
+ * After:
+ * - "오늘날씨를알려줘"
+ */
+export function normalizeSpeechText(text: string) {
+  return text
+    .normalize('NFKC')
+    .toLocaleLowerCase()
+    .replace(/[\s\p{P}\p{S}]+/gu, '')
+}
+
+function createCharacterNgrams(text: string) {
+  const ngrams = new Map<string, number>()
+  for (let index = 0; index < text.length - 1; index += 1) {
+    const ngram = text.slice(index, index + 2)
+    ngrams.set(ngram, (ngrams.get(ngram) ?? 0) + 1)
+  }
+  return ngrams
+}
+
+function ngramSimilarity(left: string, right: string) {
+  const leftNgrams = createCharacterNgrams(left)
+  const rightNgrams = createCharacterNgrams(right)
+  let shared = 0
+  for (const [ngram, count] of leftNgrams)
+    shared += Math.min(count, rightNgrams.get(ngram) ?? 0)
+
+  return (2 * shared) / Math.max(1, left.length + right.length - 2)
+}
+
+function characterSubsequenceSimilarity(left: string, right: string) {
+  const previous = new Uint16Array(right.length + 1)
+  const current = new Uint16Array(right.length + 1)
+  for (const leftCharacter of left) {
+    for (let index = 1; index <= right.length; index += 1)
+      current[index] = leftCharacter === right[index - 1] ? previous[index - 1] + 1 : Math.max(previous[index], current[index - 1])
+    previous.set(current)
+  }
+  return previous[right.length] / Math.max(left.length, right.length)
+}
+
+/**
+ * Returns whether two speech strings are likely the same utterance after
+ * ASR-friendly normalization. It intentionally ignores very short phrases so
+ * ordinary acknowledgements such as "네" are never treated as an echo.
+ */
+export function isLikelySpeechTextEcho(transcript: string, playedText: string) {
+  const normalizedTranscript = normalizeSpeechText(transcript)
+  const normalizedPlayedText = normalizeSpeechText(playedText)
+  if (normalizedTranscript.length < minimumComparableLength || normalizedPlayedText.length < minimumComparableLength)
+    return false
+  if (normalizedTranscript === normalizedPlayedText)
+    return true
+
+  // Korean particles and polite endings often add one or two syllables in ASR.
+  // Keep the lengths close as well, so a user quoting only part of a longer TTS
+  // line cannot be suppressed by incidental n-gram overlap.
+  const lengthRatio = normalizedTranscript.length / normalizedPlayedText.length
+  return lengthRatio >= 0.72
+    && lengthRatio <= 1.3
+    && (ngramSimilarity(normalizedTranscript, normalizedPlayedText) >= 0.75
+      || characterSubsequenceSimilarity(normalizedTranscript, normalizedPlayedText) >= 0.85)
+}
+
+/**
+ * Keeps only recent, actually-played TTS text for microphone echo rejection.
+ * Audio is never retained; entries expire automatically and the ring is bounded.
+ */
+export function createAssistantSpeechTextEchoGuard(options: AssistantSpeechTextEchoGuardOptions = {}) {
+  const capacity = options.capacity ?? defaultCapacity
+  const ttlMs = options.ttlMs ?? defaultTtlMs
+  const playedTexts: PlayedText[] = []
+
+  const discardExpired = (now: number) => {
+    while (playedTexts.length > 0 && now - playedTexts[0].playedAt >= ttlMs)
+      playedTexts.shift()
+  }
+
+  return {
+    record(text: string, playedAt = Date.now()) {
+      const normalized = normalizeSpeechText(text)
+      if (normalized.length < minimumComparableLength)
+        return
+      discardExpired(playedAt)
+      playedTexts.push({ text, playedAt })
+      while (playedTexts.length > capacity)
+        playedTexts.shift()
+    },
+    isEcho(transcript: string, now = Date.now()) {
+      discardExpired(now)
+      return playedTexts.some(entry => isLikelySpeechTextEcho(transcript, entry.text))
+    },
+  }
+}
