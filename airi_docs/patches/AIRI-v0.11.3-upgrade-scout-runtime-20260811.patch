diff --git a/packages/stage-ui/src/libs/speech/pcm-ring.ts b/packages/stage-ui/src/libs/speech/pcm-ring.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7a2fb1ebfec4f841bb8d1520a2a531b9ce15c6b
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/pcm-ring.ts
@@ -0,0 +1,36 @@
+/** Bounded PCM queue state shared by the AudioWorklet transport and its tests. */
+export class PcmRingBuffer {
+  private samples = new Float32Array(0)
+  private ended = false
+  private aborted = false
+
+  constructor(readonly capacity: number) {}
+
+  get available() { return this.samples.length }
+  get writable() { return Math.max(0, this.capacity - this.samples.length) }
+  get isEnded() { return this.ended }
+  get isAborted() { return this.aborted }
+
+  write(input: Float32Array) {
+    if (this.ended || this.aborted || input.length > this.writable)
+      return false
+    const next = new Float32Array(this.samples.length + input.length)
+    next.set(this.samples)
+    next.set(input, this.samples.length)
+    this.samples = next
+    return true
+  }
+
+  read(count: number) {
+    const output = this.samples.slice(0, count)
+    this.samples = this.samples.slice(output.length)
+    return output
+  }
+
+  end() { this.ended = true }
+  flush(aborted = false) {
+    this.samples = new Float32Array(0)
+    this.ended = true
+    this.aborted = aborted
+  }
+}
diff --git a/packages/stage-ui/src/libs/speech/pcm-worklet.ts b/packages/stage-ui/src/libs/speech/pcm-worklet.ts
new file mode 100644
index 0000000000000000000000000000000000000000..db38f7dc470637a3db51f45da0e9108f98a2a25e
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/pcm-worklet.ts
@@ -0,0 +1,75 @@
+import { pcm16ToFloat32 } from './incremental-wav'
+
+export interface PcmWorkletOptions {
+  channels: 1 | 2
+  sampleRate: number
+  /** Audio buffered before the node is connected. @default 80 */
+  preRollMs?: number
+  /** Maximum interleaved samples accepted by the worklet. @default 176400 */
+  capacitySamples?: number
+}
+
+/** Browser-side handle for a bounded PCM AudioWorklet queue. */
+export interface PcmWorkletPlayback {
+  writePcm16: (samples: Int16Array) => boolean
+  end: () => void
+  abort: () => void
+  ready: Promise<void>
+  finished: Promise<void>
+}
+
+const processorSource = `
+class AiriPcmRingProcessor extends AudioWorkletProcessor {
+  constructor(options) { super(); this.channels = options.processorOptions.channels; this.capacity = options.processorOptions.capacity; this.queue = []; this.offset = 0; this.ended = false; this.aborted = false; this.buffered = 0; this.fadeFrames = 0;
+    this.port.onmessage = ({data}) => { if (data.type === 'write' && !this.ended && !this.aborted && this.buffered + data.samples.length <= this.capacity) { this.queue.push(new Float32Array(data.samples)); this.buffered += data.samples.length; this.port.postMessage({type:'space', writable:this.capacity-this.buffered}); } else if (data.type === 'end') this.ended = true; else if (data.type === 'abort') { this.aborted=true; this.ended=true; this.fadeFrames=Math.ceil(sampleRate * 0.012); } };
+  }
+  process(_inputs, outputs) { const output = outputs[0]; for (let frame=0; frame<output[0].length; frame++) { const gain=this.aborted ? Math.max(0, this.fadeFrames / Math.ceil(sampleRate * 0.012)) : 1; for (let channel=0; channel<this.channels; channel++) { let value=0; const sampleIndex = this.offset + channel; if (this.queue.length && sampleIndex < this.queue[0].length) value=this.queue[0][sampleIndex]; output[channel][frame]=value * gain; } if (this.aborted) { this.fadeFrames--; if (this.fadeFrames <= 0) { this.queue=[]; this.offset=0; this.buffered=0; } } else if (this.queue.length) { this.offset += this.channels; this.buffered -= this.channels; if (this.offset >= this.queue[0].length) { this.queue.shift(); this.offset=0; } } } this.port.postMessage({type:'space', writable:this.capacity-this.buffered}); if (this.ended && this.buffered <= 0) { this.port.postMessage({type:'finished'}); return false; } return true; }
+}
+registerProcessor('airi-pcm-ring', AiriPcmRingProcessor)`
+
+/**
+ * Creates an AudioWorklet that accepts interleaved PCM16 chunks. Calls to
+ * `abort()` flush the queue synchronously so cancelled intents cannot play a
+ * later buffered frame.
+ */
+export function createPcmWorkletPlayback(audioContext: AudioContext, options: PcmWorkletOptions): PcmWorkletPlayback {
+  const preRollSamples = Math.ceil((options.preRollMs ?? 80) * options.sampleRate * options.channels / 1000)
+  const capacitySamples = options.capacitySamples ?? 176_400
+  let node: AudioWorkletNode | undefined
+  let buffered = 0
+  let ended = false
+  let aborted = false
+  let resolveFinished!: () => void
+  const finished = new Promise<void>((resolve) => { resolveFinished = resolve })
+  const blobUrl = URL.createObjectURL(new Blob([processorSource], { type: 'application/javascript' }))
+  const ready = audioContext.audioWorklet.addModule(blobUrl).then(() => {
+    URL.revokeObjectURL(blobUrl)
+    if (aborted)
+      return
+    node = new AudioWorkletNode(audioContext, 'airi-pcm-ring', { outputChannelCount: [options.channels], processorOptions: { channels: options.channels, capacity: capacitySamples } })
+    node.port.onmessage = ({ data }: MessageEvent<{ type: string, writable?: number }>) => {
+      if (data.type === 'space' && typeof data.writable === 'number')
+        buffered = capacitySamples - data.writable
+      else if (data.type === 'finished')
+        resolveFinished()
+    }
+    node.connect(audioContext.destination)
+  }).catch((error) => {
+    URL.revokeObjectURL(blobUrl)
+    throw error
+  })
+  return {
+    ready,
+    writePcm16(samples) {
+      if (!node || ended || aborted || samples.length > capacitySamples - buffered)
+        return false
+      const floats = pcm16ToFloat32(samples)
+      buffered += floats.length
+      node.port.postMessage({ type: 'write', samples: floats }, [floats.buffer])
+      return buffered >= preRollSamples
+    },
+    end() { ended = true; node?.port.postMessage({ type: 'end' }) },
+    abort() { aborted = true; ended = true; buffered = 0; node?.port.postMessage({ type: 'abort' }); setTimeout(() => { node?.disconnect(); resolveFinished() }, 15) },
+    finished,
+  }
+}
