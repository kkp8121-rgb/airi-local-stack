@@ -0,0 +1,37 @@
+import { describe, expect, it, vi } from 'vitest'
+import { createAssistantSpeechTextEchoGuard } from '@proj-airi/stage-ui/libs/speech/text-self-echo'
+
+import { acceptVoiceTranscript } from './voice-transcript-ingestion-guard'
+
+describe('acceptVoiceTranscript', () => {
+  it('keeps a blocked self-echo out of caption, chat, journal, and memory ingestion', () => {
+    const echoGuard = createAssistantSpeechTextEchoGuard()
+    echoGuard.record('오늘 날씨를 알려줘')
+    const caption = vi.fn()
+    const chat = vi.fn()
+    const journal = vi.fn()
+    const memory = vi.fn()
+
+    const accepted = acceptVoiceTranscript('오늘 날씨 알려줘요', text => echoGuard.isEcho(text), () => {
+      caption()
+      chat()
+      journal()
+      memory()
+    })
+
+    expect(accepted).toBe(false)
+    expect(caption).not.toHaveBeenCalled()
+    expect(chat).not.toHaveBeenCalled()
+    expect(journal).not.toHaveBeenCalled()
+    expect(memory).not.toHaveBeenCalled()
+  })
+
+  it('runs the user-text pipeline for a genuine transcript', () => {
+    const ingest = vi.fn()
+
+    const accepted = acceptVoiceTranscript('네, 계속해줘', () => false, ingest)
+
+    expect(accepted).toBe(true)
+    expect(ingest).toHaveBeenCalledOnce()
+  })
+})
