+import { describe, expect, it } from 'vitest'
+
+import { createAssistantSpeechTextEchoGuard, isLikelySpeechTextEcho, normalizeSpeechText } from './text-self-echo'
+
+describe('speech text self-echo comparison', () => {
+  it('matches exact, whitespace/punctuation, and NFKC variants', () => {
+    expect(isLikelySpeechTextEcho('안녕하세요 여러분', '안녕하세요 여러분')).toBe(true)
+    expect(isLikelySpeechTextEcho('안녕하세요, 여러분!', '안녕하세요 여러분')).toBe(true)
+    expect(normalizeSpeechText('ＡＢＣ １２３')).toBe('abc123')
+    expect(isLikelySpeechTextEcho('ABC 123', 'ＡＢＣ１２３')).toBe(true)
+  })
+
+  it('matches a benign Korean particle or polite-ending variation', () => {
+    expect(isLikelySpeechTextEcho('오늘 날씨 알려줘요', '오늘 날씨를 알려줘')).toBe(true)
+  })
+
+  it('does not suppress acknowledgements or partial overlap', () => {
+    expect(isLikelySpeechTextEcho('네', '네, 지금 도와드릴게요')).toBe(false)
+    expect(isLikelySpeechTextEcho('날씨 알려줘', '오늘 날씨를 알려줘. 서울의 현재 날씨를 확인할게요.')).toBe(false)
+  })
+})
+
+describe('createAssistantSpeechTextEchoGuard', () => {
+  it('expires entries and bounds the retained text ring', () => {
+    const guard = createAssistantSpeechTextEchoGuard({ capacity: 1, ttlMs: 100 })
+    guard.record('첫 번째 응답입니다', 1_000)
+    expect(guard.isEcho('첫 번째 응답입니다', 1_050)).toBe(true)
+    expect(guard.isEcho('첫 번째 응답입니다', 1_100)).toBe(false)
+
+    guard.record('바다와 파도가 아름답습니다', 2_000)
+    guard.record('컴퓨터 화면을 정리할게요', 2_001)
+    expect(guard.isEcho('바다와 파도가 아름답습니다', 2_010)).toBe(false)
+    expect(guard.isEcho('컴퓨터 화면을 정리할게요', 2_010)).toBe(true)
+  })
+})
diff --git a/packages/stage-ui/src/libs/speech/text-self-echo.ts b/packages/stage-ui/src/libs/speech/text-self-echo.ts
