index 00000000..95a02929
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/local-wav-response.ts
@@ -0,0 +1,126 @@
+import { IncrementalPcmWavParser } from './incremental-wav'
+
+export interface LocalSpeechResponseRequest {
+  url: string | URL
+  headers?: HeadersInit
+  body: BodyInit
+  fetch?: (input: URL, init: RequestInit) => Promise<Response>
+}
+
+export interface ReadLocalWavOptions {
+  signal: AbortSignal
+  onPcm: (chunk: ReturnType<IncrementalPcmWavParser['push']>[number]) => void | Promise<void>
+}
+
+const MAX_FALLBACK_PREFIX_BYTES = 512 * 1024
+
+/** Retains a bounded pre-recognition prefix without holding a large stream. */
+export class BoundedFallbackPrefix {
+  private chunks: Uint8Array[] = []
+  private length = 0
+  private overflowed = false
+
+  append(chunk: Uint8Array) {
+    if (this.overflowed)
+      return
+    const remaining = MAX_FALLBACK_PREFIX_BYTES - this.length
+    if (remaining <= 0) {
+      this.overflowed = true
+      this.chunks = []
+      return
+    }
+    if (chunk.byteLength > remaining) {
+      this.chunks.push(chunk.slice(0, remaining))
+      this.length += remaining
+      this.overflowed = true
+      this.chunks = []
+      return
+    }
+    this.chunks.push(chunk)
+    this.length += chunk.byteLength
+  }
+
+  clear() {
+    this.chunks = []
+    this.length = 0
+  }
+
+  toArrayBuffer() {
+    if (this.overflowed)
+      return undefined
+    const output = new Uint8Array(this.length)
+    let offset = 0
+    for (const chunk of this.chunks) {
+      output.set(chunk, offset)
+      offset += chunk.byteLength
+    }
+    return output.buffer
+  }
+}
+
+/**
+ * Fetches local TTS with the caller's abort signal and exposes parsed PCM as
+ * soon as the WAV data chunk arrives. Unsupported input remains available as
+ * an ArrayBuffer fallback for decodeAudioData up to the bounded prefix limit.
+ */
+export async function readLocalWavResponse(request: LocalSpeechResponseRequest, options: ReadLocalWavOptions) {
+  const response = await (request.fetch ?? globalThis.fetch)(new URL(request.url), {
+    method: 'POST',
+    headers: request.headers,
+    body: request.body,
+    signal: options.signal,
+  })
+  if (!response.ok)
+    throw new Error(`Local speech request failed: ${response.status}`)
+
+  if (!response.body) {
+    const fallback = await response.arrayBuffer()
+    if (fallback.byteLength > MAX_FALLBACK_PREFIX_BYTES)
+      throw new Error(`Unsupported local speech response exceeds ${MAX_FALLBACK_PREFIX_BYTES}-byte fallback limit`)
+    return { response, streamed: false, fallback }
+  }
+
+  const reader = response.body.getReader()
+  const parser = new IncrementalPcmWavParser()
+  // Keep bytes only until the parser commits to a supported PCM data stream.
+  // Once committed, audio reaches the worklet and retaining the transport body
+  // would make a long response consume unbounded memory for an unused fallback.
+  const fallbackPrefix = new BoundedFallbackPrefix()
+  let streamed = false
+  let recognizedWav = false
+  try {
+    while (!options.signal.aborted) {
+      const { done, value } = await reader.read()
+      if (done)
+        break
+      if (!value)
+        continue
+      if (!recognizedWav)
+        fallbackPrefix.append(value)
+      const pcmChunks = parser.push(value)
+      if (!parser.supported)
+        continue
+      if (parser.hasData) {
+        recognizedWav = true
+        fallbackPrefix.clear()
+      }
+      for (const pcm of pcmChunks) {
+        streamed = true
+        await options.onPcm(pcm)
+      }
+    }
+  }
+  finally {
+    if (options.signal.aborted)
+      await reader.cancel().catch(() => {})
+  }
+  if (options.signal.aborted)
+    return { response, streamed: false, fallback: undefined }
+  if (streamed || recognizedWav)
+    return { response, streamed: true, fallback: undefined }
+
+  const fallback = fallbackPrefix.toArrayBuffer()
+  if (!fallback)
+    throw new Error(`Unsupported local speech response exceeds ${MAX_FALLBACK_PREFIX_BYTES}-byte fallback limit`)
+  return { response, streamed: false, fallback }
+}
