index 00000000..039039fb
--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/pcm-worklet.ts
@@ -0,0 +1,220 @@
+export interface PcmWorkletOptions {
+  channels: 1 | 2
+  sampleRate: number
+  /** Audio buffered before the node is connected. @default 80 */
+  preRollMs?: number
+  /** Maximum interleaved samples accepted by the worklet. @default 176400 */
+  capacitySamples?: number
+}
+
+export interface PcmWorkletWriteResult {
+  /** Every submitted sample was acknowledged by the bounded processor. */
+  accepted: boolean
+  /** The worklet was connected and can now render audible audio. */
+  started: boolean
+}
+
+/** Browser-side handle for a bounded PCM AudioWorklet queue. */
+export interface PcmWorkletPlayback {
+  writePcm: (samples: Float32Array) => Promise<PcmWorkletWriteResult>
+  end: () => Promise<PcmWorkletWriteResult>
+  abort: () => void
+  ready: Promise<void>
+  finished: Promise<void>
+}
+
+const processorSource = `
+class AiriPcmRingProcessor extends AudioWorkletProcessor {
+  constructor(options) { super(); this.channels = options.processorOptions.channels; this.capacity = options.processorOptions.capacity; this.queue = []; this.offset = 0; this.ended = false; this.aborted = false; this.buffered = 0; this.fadeFrames = 0; this.revision = 0; this.lastWriteId = 0;
+    this.report = (type, extra = {}) => this.port.postMessage({type, buffered:this.buffered, revision:++this.revision, ...extra});
+    this.port.onmessage = ({data}) => { if (data.type === 'write') { const id = data.id; const accepted = Number.isSafeInteger(id) && id > this.lastWriteId && !this.ended && !this.aborted && this.buffered + data.samples.length <= this.capacity; this.lastWriteId = Math.max(this.lastWriteId, Number.isSafeInteger(id) ? id : 0); if (accepted) { this.queue.push(new Float32Array(data.samples)); this.buffered += data.samples.length; } this.report('ack', {id, accepted}); } else if (data.type === 'end') { this.ended = true; this.report('space'); } else if (data.type === 'abort') { this.aborted=true; this.ended=true; this.fadeFrames=Math.ceil(sampleRate * 0.012); this.report('space'); } };
+  }
+  process(_inputs, outputs) { const output = outputs[0]; const before = this.buffered; for (let frame=0; frame<output[0].length; frame++) { const gain=this.aborted ? Math.max(0, this.fadeFrames / Math.ceil(sampleRate * 0.012)) : 1; for (let channel=0; channel<this.channels; channel++) { let value=0; const sampleIndex = this.offset + channel; if (this.queue.length && sampleIndex < this.queue[0].length) value=this.queue[0][sampleIndex]; output[channel][frame]=value * gain; } if (this.aborted) { this.fadeFrames--; if (this.fadeFrames <= 0) { this.queue=[]; this.offset=0; this.buffered=0; } } else if (this.queue.length) { this.offset += this.channels; this.buffered -= this.channels; if (this.offset >= this.queue[0].length) { this.queue.shift(); this.offset=0; } } } if (this.buffered !== before) this.report('space'); if (this.ended && this.buffered <= 0) { this.port.postMessage({type:'finished'}); return false; } return true; }
+}
+registerProcessor('airi-pcm-ring', AiriPcmRingProcessor)`
+
+interface ProcessorMessage {
+  type: 'ack' | 'space' | 'finished'
+  id?: number
+  accepted?: boolean
+  buffered?: number
+  revision?: number
+}
+
+interface PendingWrite {
+  id: number
+  resolve: (accepted: boolean) => void
+  reject: (error: Error) => void
+}
+
+/**
+ * Creates an AudioWorklet that accepts interleaved Float32 chunks. Exactly one
+ * write is in flight: every slice is acknowledged with a monotonic id before
+ * another can be sent. Occupancy snapshots are revision-gated, so a delayed
+ * `space` message cannot overwrite a newer processor acknowledgement.
+ */
+export function createPcmWorkletPlayback(audioContext: AudioContext, options: PcmWorkletOptions): PcmWorkletPlayback {
+  const capacitySamples = options.capacitySamples ?? 176_400
+  const preRollSamples = Math.min(capacitySamples, Math.ceil((options.preRollMs ?? 80) * options.sampleRate * options.channels / 1000))
+  let node: AudioWorkletNode | undefined
+  let buffered = 0
+  let revision = 0
+  let nextWriteId = 1
+  let pendingWrite: PendingWrite | undefined
+  let accepting = true
+  let ending = false
+  let aborted = false
+  let connected = false
+  let resolveFinished!: () => void
+  let finishedSettled = false
+  const spaceWaiters = new Set<() => void>()
+  const finished = new Promise<void>((resolve) => { resolveFinished = resolve })
+  const blobUrl = URL.createObjectURL(new Blob([processorSource], { type: 'application/javascript' }))
+  let writeTail = Promise.resolve()
+  let endPromise: Promise<PcmWorkletWriteResult> | undefined
+
+  function settleFinished() {
+    if (finishedSettled)
+      return
+    finishedSettled = true
+    node?.disconnect()
+    resolveFinished()
+  }
+
+  function releaseSpaceWaiters() {
+    for (const resolve of spaceWaiters)
+      resolve()
+    spaceWaiters.clear()
+  }
+
+  function updateOccupancy(message: ProcessorMessage) {
+    if (typeof message.revision !== 'number' || typeof message.buffered !== 'number' || message.revision <= revision)
+      return
+    revision = message.revision
+    buffered = message.buffered
+    releaseSpaceWaiters()
+  }
+
+  function start(force = false) {
+    if (!node || connected || buffered === 0 || (!force && buffered < preRollSamples))
+      return false
+    node.connect(audioContext.destination)
+    connected = true
+    return true
+  }
+
+  function waitForSpace() {
+    if (aborted)
+      return Promise.resolve()
+    return new Promise<void>((resolve) => spaceWaiters.add(resolve))
+  }
+
+  function awaitAck(id: number) {
+    return new Promise<boolean>((resolve, reject) => {
+      pendingWrite = { id, resolve, reject }
+    })
+  }
+
+  function cancelPendingWrite() {
+    if (!pendingWrite)
+      return
+    pendingWrite.resolve(false)
+    pendingWrite = undefined
+  }
+
+  const ready = audioContext.audioWorklet.addModule(blobUrl).then(() => {
+    URL.revokeObjectURL(blobUrl)
+    if (aborted || ending)
+      return
+    node = new AudioWorkletNode(audioContext, 'airi-pcm-ring', { outputChannelCount: [options.channels], processorOptions: { channels: options.channels, capacity: capacitySamples } })
+    node.port.onmessage = ({ data }: MessageEvent<ProcessorMessage>) => {
+      if (data.type === 'finished') {
+        settleFinished()
+        return
+      }
+      updateOccupancy(data)
+      if (data.type !== 'ack' || !pendingWrite || data.id !== pendingWrite.id)
+        return
+      const pending = pendingWrite
+      pendingWrite = undefined
+      if (data.accepted)
+        pending.resolve(true)
+      else
+        pending.reject(new Error(`PCM worklet rejected write ${data.id}`))
+    }
+  }).catch((error) => {
+    URL.revokeObjectURL(blobUrl)
+    throw error
+  })
+
+  async function writeOne(samples: Float32Array) {
+    if (!node || ending || aborted)
+      return { accepted: false, started: false }
+    if (samples.length % options.channels !== 0)
+      throw new Error('Interleaved PCM chunks must contain whole frames')
+
+    let offset = 0
+    while (offset < samples.length && !aborted && !ending) {
+      const writableFrames = Math.floor((capacitySamples - buffered) / options.channels)
+      if (writableFrames === 0) {
+        await waitForSpace()
+        continue
+      }
+      const count = Math.min(samples.length - offset, writableFrames * options.channels)
+      const portion = samples.slice(offset, offset + count)
+      const id = nextWriteId++
+      const acknowledged = awaitAck(id)
+      node.port.postMessage({ type: 'write', id, samples: portion }, [portion.buffer])
+      if (!await acknowledged)
+        return { accepted: false, started: connected }
+      offset += count
+      start()
+    }
+    return { accepted: offset === samples.length && !aborted && !ending, started: connected }
+  }
+
+  return {
+    ready,
+    writePcm(samples) {
+      if (!accepting || aborted)
+        return Promise.resolve({ accepted: false, started: false })
+      const task = writeTail.then(() => writeOne(samples))
+      writeTail = task.then(() => undefined, () => undefined)
+      return task
+    },
+    end() {
+      if (endPromise)
+        return endPromise
+      // Close admission immediately, but let tasks that were already appended
+      // to writeTail finish before placing the terminal message after them.
+      accepting = false
+      const priorWrites = writeTail
+      endPromise = (async () => {
+        await priorWrites
+        ending = true
+        if (aborted)
+          return { accepted: false, started: false }
+        const started = start(true)
+        if (!node || (!connected && buffered === 0)) {
+          settleFinished()
+          return { accepted: true, started: connected || started }
+        }
+        node.port.postMessage({ type: 'end' })
+        return { accepted: true, started: connected || started }
+      })()
+      return endPromise
+    },
+    abort() {
+      aborted = true
+      accepting = false
+      ending = true
+      cancelPendingWrite()
+      releaseSpaceWaiters()
+      node?.port.postMessage({ type: 'abort' })
+      // The processor owns its queue, so abort cannot synchronously flush it;
+      // it fades an in-flight frame before discarding queued audio.
+      setTimeout(settleFinished, 15)
+    },
+    finished,
+  }
+}
diff --git a/packages/stage-ui/src/libs/speech/text-self-echo.test.ts b/packages/stage-ui/src/libs/speech/text-self-echo.test.ts
