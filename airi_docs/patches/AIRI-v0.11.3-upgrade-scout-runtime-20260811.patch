+import { describe, expect, it } from 'vitest'
+
+import { PcmStreamResampler } from './pcm-resampler'
+
+function rendered(resampler: PcmStreamResampler, chunks: Int16Array[]) {
+  return chunks.flatMap(chunk => [...resampler.push(chunk)]).concat([...resampler.finish()])
+}
+
+describe('PcmStreamResampler', () => {
+  it('preserves 32 kHz duration at a 48 kHz output rate within one frame', () => {
+    const input = Int16Array.from({ length: 320 }, (_value, index) => index - 160)
+    const output = rendered(new PcmStreamResampler(32_000, 48_000, 1), [input])
+    expect(output.length).toBeGreaterThanOrEqual(479)
+    expect(output.length).toBeLessThanOrEqual(481)
+  })
+
+  it('is identical for arbitrarily split mono and stereo source frames', () => {
+    const mono = Int16Array.from({ length: 37 }, (_value, index) => (index * 173) - 3000)
+    const stereo = Int16Array.from({ length: 38 }, (_value, index) => (index * 97) - 2000)
+    for (const input of [mono, stereo]) {
+      const channels = input === stereo ? 2 : 1 as const
+      const whole = rendered(new PcmStreamResampler(32_000, 48_000, channels), [input])
+      const split = rendered(new PcmStreamResampler(32_000, 48_000, channels), [input.slice(0, 3), input.slice(3, 11), input.slice(11)])
+      expect(split).toEqual(whole)
+    }
+  })
+
+  it('keeps identity PCM samples exact while retaining incomplete stereo frames', () => {
+    const output = rendered(new PcmStreamResampler(48_000, 48_000, 2), [new Int16Array([0, 16384, -16384]), new Int16Array([32767])])
+    expect(output).toEqual([0, 0.5, -0.5, 32767 / 32768])
+  })
+})
diff --git a/packages/stage-ui/src/libs/speech/pcm-resampler.ts b/packages/stage-ui/src/libs/speech/pcm-resampler.ts
