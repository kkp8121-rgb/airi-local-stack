+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { streamLocalSttTranscription } from './stream-transcription'
+
+class FakeSocket {
+  static CONNECTING = 0
+  static OPEN = 1
+  static CLOSED = 3
+  static instances: FakeSocket[] = []
+
+  bufferedAmount = 0
+  readyState = FakeSocket.CONNECTING
+  sent: string[] = []
+  onclose: ((event: CloseEvent) => unknown) | null = null
+  onerror: ((event: Event) => unknown) | null = null
+  onmessage: ((event: MessageEvent) => unknown) | null = null
+  onopen: ((event: Event) => unknown) | null = null
+
+  constructor(_url: string) {
+    FakeSocket.instances.push(this)
+  }
+
+  close() {
+    if (this.readyState === FakeSocket.CLOSED) return
+    this.readyState = FakeSocket.CLOSED
+    this.onclose?.({} as CloseEvent)
+  }
+
+  open() {
+    this.readyState = FakeSocket.OPEN
+    void this.onopen?.({} as Event)
+  }
+
+  send(payload: string) {
+    this.sent.push(payload)
+  }
+}
+
+function pendingAudioStream(onCancel: () => void) {
+  return new ReadableStream<ArrayBuffer>({ cancel: onCancel })
+}
+
+async function flushAsyncWork() {
+  await Promise.resolve()
+  await Promise.resolve()
+}
+
+describe('streamLocalSttTranscription', () => {
+  afterEach(() => {
+    FakeSocket.instances = []
+    vi.unstubAllGlobals()
+  })
+
+  it('cancels and releases a blocked microphone reader when aborted', async () => {
+    vi.stubGlobal('WebSocket', FakeSocket)
+    const abortController = new AbortController()
+    const cancelled = vi.fn()
+    const result = streamLocalSttTranscription({
+      abortSignal: abortController.signal,
+      baseURL: 'http://127.0.0.1:2026/v1/',
+      inputAudioStream: pendingAudioStream(cancelled),
+    })
+    void result.text.catch(() => {})
+
+    FakeSocket.instances[0].open()
+    await flushAsyncWork()
+    abortController.abort()
+    await flushAsyncWork()
+
+    expect(cancelled).toHaveBeenCalledTimes(1)
+    expect(FakeSocket.instances[0].readyState).toBe(FakeSocket.CLOSED)
+  })
+
+  it('cancels the reader and closes the transport after a server error', async () => {
+    vi.stubGlobal('WebSocket', FakeSocket)
+    const cancelled = vi.fn()
+    const result = streamLocalSttTranscription({
+      baseURL: 'http://127.0.0.1:2026/v1/',
+      inputAudioStream: pendingAudioStream(cancelled),
+    })
+    void result.text.catch(() => {})
+
+    const socket = FakeSocket.instances[0]
+    socket.open()
+    await flushAsyncWork()
+    socket.onmessage?.({ data: JSON.stringify({ type: 'error', message: 'decoder failed' }) } as MessageEvent)
+    await flushAsyncWork()
+
+    expect(cancelled).toHaveBeenCalledTimes(1)
+    expect(socket.readyState).toBe(FakeSocket.CLOSED)
+  })
+})
