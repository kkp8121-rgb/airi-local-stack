@@ -0,0 +1,35 @@
+export interface AttemptTimeoutSignal {
+  signal: AbortSignal
+  cleanup: () => void
+}
+
+/**
+ * Creates an abort signal for one physical request attempt without changing
+ * the caller-owned parent signal. The caller must run `cleanup()` when that
+ * attempt settles so neither the timer nor the parent listener leaks into a
+ * later retry.
+ */
+export function createAttemptTimeoutSignal(parent: AbortSignal, timeoutMs: number): AttemptTimeoutSignal {
+  const controller = new AbortController()
+  let timeout: ReturnType<typeof setTimeout> | undefined
+
+  const abortFromParent = () => controller.abort(parent.reason)
+  if (parent.aborted) {
+    abortFromParent()
+  }
+  else {
+    parent.addEventListener('abort', abortFromParent, { once: true })
+    timeout = setTimeout(() => {
+      controller.abort('tts-attempt-timeout')
+    }, Math.max(0, timeoutMs))
+  }
+
+  return {
+    signal: controller.signal,
+    cleanup: () => {
+      if (timeout)
+        clearTimeout(timeout)
+      parent.removeEventListener('abort', abortFromParent)
+    },
+  }
+}
