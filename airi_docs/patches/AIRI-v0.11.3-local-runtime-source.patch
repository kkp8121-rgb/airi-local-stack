+const endpoint = 'http://127.0.0.1:8892/api/event'
+const maxTrackedTurns = 64
+
+type LatencyFetch = (input: RequestInfo | URL, init?: RequestInit) => Promise<unknown>
+type LatencySource = 'stt' | 'llm' | 'playback'
+type LatencyPhase = 'start' | 'end' | 'content'
+
+/**
+ * Emits only numeric timestamps and an opaque, per-turn correlation id to the
+ * local latency monitor. Transcript/LLM text and chat-session ids never leave
+ * this module.
+ */
+export function createVoiceTurnLatencyTrace(fetchImpl: LatencyFetch = globalThis.fetch, now = () => Date.now()) {
+  const acceptedTurns = new Set<string>()
+  const firstLlmDeltaTurns = new Set<string>()
+
+  function post(source: LatencySource, phase: LatencyPhase, roundId: string) {
+    try {
+      void fetchImpl(endpoint, {
+        method: 'POST',
+        body: JSON.stringify({ source, phase, request_id: roundId, timestamp_ms: now() }),
+      }).catch(() => {})
+    }
+    catch {}
+  }
+
+  function retain(turns: Set<string>, roundId: string) {
+    turns.add(roundId)
+    while (turns.size > maxTrackedTurns)
+      turns.delete(turns.values().next().value!)
+  }
+
+  return {
+    /**
+     * Marks an accepted voice turn for later LLM/playback correlation.
+     *
+     * The loopback STT service owns the real request start/end timestamps.
+     * Re-emitting both phases here, after the transcript has already arrived,
+     * would replace that measured duration with an artificial 0-1 ms turn in
+     * the monitor's request-id map.
+     */
+    sttAccepted(roundId?: string) {
+      if (!roundId)
+        return
+      retain(acceptedTurns, roundId)
+    },
+    /** Records only the first non-whitespace LLM delta for an accepted turn. */
+    firstSubstantiveLlmDelta(roundId: string | undefined, delta: string) {
+      if (!roundId || !acceptedTurns.has(roundId) || firstLlmDeltaTurns.has(roundId) || !delta.trim())
+        return
+      retain(firstLlmDeltaTurns, roundId)
+      post('llm', 'content', roundId)
+    },
+    /** Records only the first actual Web Audio playback start for that turn. */
+    firstPlaybackStart(roundId?: string) {
+      if (!roundId || !acceptedTurns.delete(roundId))
+        return
+      firstLlmDeltaTurns.delete(roundId)
+      post('playback', 'start', roundId)
+    },
+  }
+}
+
+export const voiceTurnLatencyTrace = createVoiceTurnLatencyTrace()
