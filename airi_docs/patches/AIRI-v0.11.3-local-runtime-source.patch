+import { describe, expect, it } from 'vitest'
+import { createInitialLastCapture, createVoiceInputRuntimeSnapshot, isExactLoopbackServerUrl, markLastCapture, readMicrophonePermissionPassive } from './voice-input-runtime'
+
+describe('local voice status privacy helpers', () => {
+  it('only permits exact plaintext loopback URLs', () => {
+    expect(isExactLoopbackServerUrl('ws://127.0.0.1:6121/ws')).toBe(true)
+    expect(isExactLoopbackServerUrl('ws://localhost:6121/ws')).toBe(true)
+    expect(isExactLoopbackServerUrl('wss://127.0.0.1:6121/ws')).toBe(false)
+    expect(isExactLoopbackServerUrl('ws://192.168.0.2:6121/ws')).toBe(false)
+  })
+  it('fails permission reads closed without asking for permission', async () => {
+    expect(await readMicrophonePermissionPassive(undefined)).toBe('unavailable')
+    expect(await readMicrophonePermissionPassive({ query: async () => ({ state: 'granted' }) } as any)).toBe('granted')
+  })
+  it('maps non-content capture outcomes', () => {
+    expect(createInitialLastCapture()).toEqual({ outcome: 'none', atMs: null })
+    expect(markLastCapture('transcription-empty', 4)).toEqual({ outcome: 'transcription-empty', atMs: 4 })
+  })
+  it('copies only the exact public snapshot keys', () => {
+    const snapshot = createVoiceInputRuntimeSnapshot({
+      stageMounted: true,
+      voiceInputEnabled: true,
+      providerConfigured: true,
+      recording: false,
+      transcribing: false,
+      vad: {
+        active: true,
+        listening: true,
+        inputLive: true,
+        inputEnabled: true,
+        inputMuted: false,
+        isSpeech: true,
+        score: Infinity,
+        threshold: -1,
+        recentMax: 1,
+        recentSamples: [-1, 0.5, 2, Number.NaN, 'drop'],
+        text: 'drop',
+      } as any,
+      microphonePermission: 'granted',
+      lastCapture: { outcome: 'capture-started', atMs: 4, deviceLabel: 'drop' } as any,
+      transcript: 'drop',
+    } as any)
+    expect(Object.keys(snapshot).sort()).toEqual([
+      'lastCapture', 'microphonePermission', 'providerConfigured', 'recording',
+      'stageMounted', 'transcribing', 'vad', 'voiceInputEnabled',
+    ])
+    expect(Object.keys(snapshot.vad).sort()).toEqual([
+      'active', 'inputEnabled', 'inputLive', 'inputMuted', 'isSpeech', 'listening',
+      'recentMax', 'recentSamples', 'score', 'threshold',
+    ])
+    expect(Object.keys(snapshot.lastCapture).sort()).toEqual(['atMs', 'outcome'])
+    expect(JSON.stringify(snapshot)).not.toContain('drop')
+    expect(snapshot.vad.score).toBe(0)
+    expect(snapshot.vad.threshold).toBe(0)
+    expect(snapshot.vad.recentSamples).toEqual([0, 0.5, 1, 0, 0])
+    expect(snapshot.vad.recentSamples.every(value => Number.isFinite(value) && value >= 0 && value <= 1)).toBe(true)
+    expect(snapshot.vad.recentMax).toBe(1)
+  })
+})
diff --git a/apps/stage-tamagotchi/src/shared/voice-input-runtime.ts b/apps/stage-tamagotchi/src/shared/voice-input-runtime.ts
new file mode 100644
index 0000000..ebd1781
--- /dev/null
+++ b/apps/stage-tamagotchi/src/shared/voice-input-runtime.ts
@@ -0,0 +1,104 @@
+/** Content-free, passive voice-input status contract. */
+export type MicrophonePermission = 'granted' | 'denied' | 'prompt' | 'unavailable'
+export type VoiceCaptureOutcome = 'none' | 'capture-started' | 'capture-skipped' | 'transcription-started' | 'transcription-accepted' | 'transcription-empty' | 'transcription-error' | 'permission-denied' | 'stream-unavailable'
+
+export interface LocalVoiceStatusSnapshot {
+  stageMounted: boolean
+  voiceInputEnabled: boolean
+  providerConfigured: boolean
+  recording: boolean
+  transcribing: boolean
+  vad: {
+    active: boolean
+    listening: boolean
+    inputLive: boolean
+    inputEnabled: boolean
+    inputMuted: boolean
+    isSpeech: boolean
+    score: number
+    threshold: number
+    recentMax: number
+    recentSamples: number[]
+  }
+  microphonePermission: MicrophonePermission
+  lastCapture: { outcome: VoiceCaptureOutcome, atMs: number | null }
+}
+
+export const LOCAL_VOICE_STATUS_REQUEST = 'input:local:voice-status:request'
+export const LOCAL_VOICE_STATUS_RESPONSE = 'output:local:voice-status:response'
+
+export function createInitialLastCapture() {
+  return { outcome: 'none' as VoiceCaptureOutcome, atMs: null as number | null }
+}
+
+export function markLastCapture(outcome: VoiceCaptureOutcome, atMs = Date.now()) {
+  return { outcome, atMs }
+}
+
+const MAX_VAD_RECENT_SAMPLES = 50
+
+/** Limits diagnostic VAD values to finite probabilities, never raw audio data. */
+function normalizeVadProbability(value: unknown) {
+  return typeof value === 'number' && Number.isFinite(value)
+    ? Math.min(1, Math.max(0, value))
+    : 0
+}
+
+function normalizeVadRecentSamples(value: unknown) {
+  if (!Array.isArray(value))
+    return []
+  return value.slice(-MAX_VAD_RECENT_SAMPLES).map(normalizeVadProbability)
+}
+
+/** Copy only the public diagnostic contract, dropping any renderer-owned data. */
+export function createVoiceInputRuntimeSnapshot(value: LocalVoiceStatusSnapshot): LocalVoiceStatusSnapshot {
+  return {
+    stageMounted: value.stageMounted,
+    voiceInputEnabled: value.voiceInputEnabled,
+    providerConfigured: value.providerConfigured,
+    recording: value.recording,
+    transcribing: value.transcribing,
+    vad: (() => {
+      const recentSamples = normalizeVadRecentSamples(value.vad.recentSamples)
+      return {
+        active: Boolean(value.vad.active),
+        listening: Boolean(value.vad.listening),
+        inputLive: Boolean(value.vad.inputLive),
+        inputEnabled: Boolean(value.vad.inputEnabled),
+        inputMuted: Boolean(value.vad.inputMuted),
+        isSpeech: Boolean(value.vad.isSpeech),
+        score: normalizeVadProbability(value.vad.score),
+        threshold: normalizeVadProbability(value.vad.threshold),
+        recentMax: recentSamples.reduce((max, sample) => Math.max(max, sample), 0),
+        recentSamples,
+      }
+    })(),
+    microphonePermission: value.microphonePermission,
+    lastCapture: { outcome: value.lastCapture.outcome, atMs: value.lastCapture.atMs },
+  }
+}
+
+/** Exact loopback only: no TLS, aliases, ports-by-proxy, or LAN addresses. */
+export function isExactLoopbackServerUrl(value: string | undefined) {
+  if (!value)
+    return false
+  try {
+    const url = new URL(value)
+    return url.protocol === 'ws:' && (url.hostname === '127.0.0.1' || url.hostname === 'localhost' || url.hostname === '[::1]' || url.hostname === '::1')
+  }
+  catch {
+    return false
+  }
+}
+
+export async function readMicrophonePermissionPassive(permissions: Pick<Permissions, 'query'> | undefined): Promise<MicrophonePermission> {
+  if (!permissions)
+    return 'unavailable'
+  try {
+    const result = await permissions.query({ name: 'microphone' as PermissionName })
+    return result.state === 'granted' || result.state === 'denied' || result.state === 'prompt' ? result.state : 'unavailable'
+  }
+  catch {
+    return 'unavailable'
+  }
+}
