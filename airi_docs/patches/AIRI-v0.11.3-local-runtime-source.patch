+
+  it('reports content-free lifecycle counts for incomplete attempts', () => {
+    const requests: Array<{ input: RequestInfo | URL, init?: RequestInit }> = []
+    const fetchImpl = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      requests.push({ input, init })
+    })
+    const proof = createLocalBroadcastPlaybackProof(fetchImpl)
+
+    expect(proof.recordCompletion({
+      ttsRequests: 0,
+      successfulTtsResults: 0,
+      naturalPlaybackEnds: 0,
+    })).toBe(false)
+    expect(proof.recordCompletion({
+      ttsRequests: 2,
+      successfulTtsResults: 1,
+      naturalPlaybackEnds: 1,
+    })).toBe(false)
+    expect(proof.recordCompletion({
+      ttsRequests: 2,
+      successfulTtsResults: 2,
+      naturalPlaybackEnds: 1,
+    })).toBe(false)
+    expect(proof.recordCompletion({
+      ttsRequests: 1,
+      successfulTtsResults: 2,
+      naturalPlaybackEnds: 2,
+    })).toBe(false)
+    expect(fetchImpl).toHaveBeenCalledTimes(4)
+    const payload = JSON.parse(String(requests[2]?.init?.body))
+    expect(payload).toEqual({
+      schema_version: 1,
+      source: 'local-proactive-broadcast',
+      phase: 'playback-incomplete',
+      attempt_count: 3,
+      failure_code: 'pipeline-incomplete',
+      tts_requests: 2,
+      successful_tts_results: 2,
+      natural_playback_ends: 1,
