+<script setup lang="ts">
+import type { BroadcastSettingsChannelEvent } from '@proj-airi/stage-ui/stores/broadcast-director'
+
+import {
+  BROADCAST_SETTINGS_CHANNEL_NAME,
+  loadBroadcastSettings,
+  normalizeBroadcastSettings,
+  saveBroadcastSettings,
+} from '@proj-airi/stage-ui/stores/broadcast-director'
+import { useBroadcastChannel } from '@vueuse/core'
+import { computed, onMounted, onUnmounted, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+
+const { t } = useI18n()
+const tt = (key: string, named?: Record<string, number>) => named
+  ? t(`tamagotchi.settings.pages.system.local-broadcast.${key}`, named)
+  : t(`tamagotchi.settings.pages.system.local-broadcast.${key}`)
+const settings = ref(loadBroadcastSettings())
+const status = computed(() => settings.value.enabled ? tt('status.armed') : tt('status.disabled'))
+const { post } = useBroadcastChannel<BroadcastSettingsChannelEvent, BroadcastSettingsChannelEvent>({ name: BROADCAST_SETTINGS_CHANNEL_NAME })
+const postActivity = () => post({ type: 'user-activity' })
+
+function apply() {
+  settings.value = normalizeBroadcastSettings(settings.value)
+  saveBroadcastSettings(settings.value)
+  post({ type: 'settings-changed', settings: settings.value })
+}
+
+onMounted(() => {
+  globalThis.addEventListener('pointerdown', postActivity, { capture: true })
+  globalThis.addEventListener('keydown', postActivity, { capture: true })
+  globalThis.addEventListener('focus', postActivity, { capture: true })
+})
+onUnmounted(() => {
+  globalThis.removeEventListener('pointerdown', postActivity, { capture: true })
+  globalThis.removeEventListener('keydown', postActivity, { capture: true })
+  globalThis.removeEventListener('focus', postActivity, { capture: true })
+})
+</script>
+
+<template>
+  <section class="flex flex-col gap-5 rounded-lg bg-neutral-50 p-5 dark:bg-neutral-800">
+    <div class="flex items-start justify-between gap-4">
+      <div>
+        <h2 class="text-sm text-neutral-900 font-medium dark:text-neutral-50">{{ tt('title') }}</h2>
