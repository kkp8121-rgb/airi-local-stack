--- /dev/null
+++ b/packages/stage-ui/src/libs/speech/local-broadcast-playback-proof.ts
@@ -0,0 +1,96 @@
+const proofEndpoint = 'http://127.0.0.1:8892/api/event'
+
+type ProofFetch = (input: RequestInfo | URL, init?: RequestInit) => Promise<unknown>
+
+/** Counts from one local proactive speech intent at its terminal boundary. */
+export interface LocalBroadcastPlaybackEvidence {
+  /** TTS requests emitted for the matching intent. */
+  ttsRequests: number
+  /** Matching requests that returned audio. */
+  successfulTtsResults: number
+  /** Matching audio sources that reached their natural Web Audio end event. */
+  naturalPlaybackEnds: number
+}
+
+/** Fixed, content-free failure labels accepted by the loopback observer. */
+export type LocalBroadcastPlaybackFailureCode
+  = | 'invalid-proactive-speech'
+    | 'audio-context-unavailable'
+    | 'speech-provider-unavailable'
+    | 'local-rest-speech-required'
+    | 'speech-model-or-voice-unavailable'
+    | 'speech-provider-initialization-failed'
+    | 'local-speech-endpoint-required'
+    | 'audio-context-resume-failed'
+    | 'speech-stage-unavailable'
+    | 'candidate-rejected'
+    | 'candidate-too-long'
+    | 'candidate-content-rejected'
+    | 'candidate-empty-or-cancelled'
+    | 'playback-rejected'
+    | 'playback-interrupted'
+    | 'intent-cancelled'
+    | 'proactive-speech-timeout'
+    | 'pipeline-incomplete'
+
+/**
+ * Creates a session-local proof reporter. It emits only aggregate completion
+ * counts and deliberately keeps no message, intent, provider, or user data.
+ */
+export function createLocalBroadcastPlaybackProof(fetchImpl: ProofFetch = globalThis.fetch) {
+  let completionCount = 0
+  let attemptCount = 0
+
+  const post = (payload: object) => {
+    try {
+      void fetchImpl(proofEndpoint, {
+        method: 'POST',
+        body: JSON.stringify(payload),
+      }).catch(() => {})
+    }
+    catch {}
+  }
+
+  return {
+    recordIncomplete(evidence: LocalBroadcastPlaybackEvidence, failureCode: LocalBroadcastPlaybackFailureCode): false {
+      attemptCount += 1
+      post({
+        schema_version: 1,
+        source: 'local-proactive-broadcast',
+        phase: 'playback-incomplete',
+        attempt_count: attemptCount,
+        failure_code: failureCode,
+        tts_requests: evidence.ttsRequests,
+        successful_tts_results: evidence.successfulTtsResults,
+        natural_playback_ends: evidence.naturalPlaybackEnds,
+      })
+      return false
+    },
+    recordCompletion(evidence: LocalBroadcastPlaybackEvidence): boolean {
+      const verified = evidence.ttsRequests > 0
+        && evidence.successfulTtsResults === evidence.ttsRequests
+        && evidence.naturalPlaybackEnds === evidence.successfulTtsResults
+
+      if (!verified)
+        return this.recordIncomplete(evidence, 'pipeline-incomplete')
+
+      attemptCount += 1
+      completionCount += 1
+      const payload = {
+        schema_version: 1,
+        source: 'local-proactive-broadcast',
+        phase: 'playback-completed',
+        completion_count: completionCount,
+      } as const
+
+      // This loopback observation must never change the speech result. Avoiding
+      // custom headers also keeps the browser request free of a CORS preflight.
+      post(payload)
+
+      return true
+    },
+  }
+}
+
+/** One renderer-session reporter shared by the director and Stage boundary. */
+export const localBroadcastPlaybackProof = createLocalBroadcastPlaybackProof()
