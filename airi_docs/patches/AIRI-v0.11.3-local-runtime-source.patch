+
+  it('reports fixed preflight failure codes without content or correlation data', () => {
+    const requests: Array<{ input: RequestInfo | URL, init?: RequestInit }> = []
+    const proof = createLocalBroadcastPlaybackProof(async (input, init) => { requests.push({ input, init }) })
+
+    expect(proof.recordIncomplete({
+      ttsRequests: 0,
+      successfulTtsResults: 0,
+      naturalPlaybackEnds: 0,
+    }, 'speech-provider-unavailable')).toBe(false)
+
+    expect(JSON.parse(String(requests[0]?.init?.body))).toEqual({
+      schema_version: 1,
+      source: 'local-proactive-broadcast',
+      phase: 'playback-incomplete',
+      attempt_count: 1,
+      failure_code: 'speech-provider-unavailable',
+      tts_requests: 0,
+      successful_tts_results: 0,
+      natural_playback_ends: 0,
+    })
+  })
+
+  it('keeps the payload free of content and correlation fields', () => {
+    const requests: Array<{ input: RequestInfo | URL, init?: RequestInit }> = []
+    const fetchImpl = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      requests.push({ input, init })
+    })
+    const proof = createLocalBroadcastPlaybackProof(fetchImpl)
+
+    proof.recordCompletion({
+      ttsRequests: 1,
+      successfulTtsResults: 1,
+      naturalPlaybackEnds: 1,
+    })
+
+    const payload = JSON.parse(String(requests[0]?.init?.body))
+    expect(Object.keys(payload).sort()).toEqual([
+      'completion_count',
+      'phase',
+      'schema_version',
+      'source',
+    ])
+    expect(payload).not.toHaveProperty('text')
+    expect(payload).not.toHaveProperty('request_id')
+    expect(payload).not.toHaveProperty('intent_id')
+    expect(payload).not.toHaveProperty('round_id')
+    expect(payload).not.toHaveProperty('timestamp')
+    expect(payload).not.toHaveProperty('provider')
+    expect(payload).not.toHaveProperty('model')
+  })
+
+  it('fails soft when the loopback POST rejects or throws synchronously', async () => {
+    const rejectedFetch = vi.fn(async () => {
+      throw new Error('offline')
+    })
+    const rejectedProof = createLocalBroadcastPlaybackProof(rejectedFetch)
+
+    expect(rejectedProof.recordCompletion({
+      ttsRequests: 1,
+      successfulTtsResults: 1,
+      naturalPlaybackEnds: 1,
+    })).toBe(true)
+    await Promise.resolve()
+
+    const throwingFetch = vi.fn(() => {
+      throw new Error('unavailable')
+    })
+    const throwingProof = createLocalBroadcastPlaybackProof(throwingFetch)
+    expect(throwingProof.recordCompletion({
+      ttsRequests: 1,
+      successfulTtsResults: 1,
+      naturalPlaybackEnds: 1,
+    })).toBe(true)
+  })
+})
diff --git a/packages/stage-ui/src/libs/speech/local-broadcast-playback-proof.ts b/packages/stage-ui/src/libs/speech/local-broadcast-playback-proof.ts
