@@ -0,0 +1,11 @@
+const backgroundArgument = '--background'
+
+/**
+ * Returns whether this AIRI launch should keep the main window hidden.
+ *
+ * The same command-line convention is used for the initial process and for
+ * launches forwarded to Electron's primary single-instance process.
+ */
+export function startsInBackground(commandLine: readonly string[]) {
+  return commandLine.includes(backgroundArgument)
+}
