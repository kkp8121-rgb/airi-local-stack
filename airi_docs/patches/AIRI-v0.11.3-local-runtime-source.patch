+import { describe, expect, it, vi } from 'vitest'
+
+import { VAD } from './vad'
+
+describe('VAD speech-ready PCM', () => {
+  it('keeps the bounded pre-roll before the first detected speech frame', async () => {
+    const vad = new VAD({
+      sampleRate: 1000,
+      newBufferSize: 2,
+      speechPadMs: 2,
+      minSilenceDurationMs: 2,
+      minSpeechDurationMs: 1,
+      maxBufferDuration: 1,
+    })
+    const speechReady = vi.fn()
+    vad.on('speech-ready', speechReady)
+
+    const decisions = [false, true, false]
+    Object.assign(vad as unknown as { isReady: boolean }, { isReady: true })
+    vi.spyOn(vad as unknown as { detectSpeech: (buffer: Float32Array) => Promise<boolean> }, 'detectSpeech')
+      .mockImplementation(async () => decisions.shift() ?? false)
+
+    await vad.processAudio(new Float32Array([0.1, 0.2]))
+    await vad.processAudio(new Float32Array([0.3, 0.4]))
+    await vad.processAudio(new Float32Array([0, 0]))
+
+    expect(speechReady).toHaveBeenCalledOnce()
+    const event = speechReady.mock.calls[0]?.[0]
+    expect(event.sampleRate).toBe(1000)
+    expect(event.preRollSamples).toBe(2)
+    expect(Array.from(event.buffer.slice(0, 4))).toEqual([
+      expect.closeTo(0.1),
+      expect.closeTo(0.2),
+      expect.closeTo(0.3),
+      expect.closeTo(0.4),
+    ])
+  })
+
+  it('does not emit a speech-ready segment for speech shorter than the configured minimum', async () => {
+    const vad = new VAD({
+      sampleRate: 1000,
+      newBufferSize: 2,
+      minSilenceDurationMs: 2,
+      minSpeechDurationMs: 5,
+      maxBufferDuration: 1,
+    })
+    const speechReady = vi.fn()
+    vad.on('speech-ready', speechReady)
+
+    const decisions = [true, false]
+    Object.assign(vad as unknown as { isReady: boolean }, { isReady: true })
+    vi.spyOn(vad as unknown as { detectSpeech: (buffer: Float32Array) => Promise<boolean> }, 'detectSpeech')
+      .mockImplementation(async () => decisions.shift() ?? false)
+
+    await vad.processAudio(new Float32Array([0.3, 0.4]))
+    await vad.processAudio(new Float32Array([0, 0]))
+
+    expect(speechReady).not.toHaveBeenCalled()
+  })
+})
