@@ -0,0 +1,212 @@
+/** Local, opt-in idle broadcast scheduler. It owns no network or persistence. */
+export type BroadcastDirectorState = 'disabled' | 'waiting' | 'armed' | 'producing' | 'validating' | 'speaking' | 'cooldown'
+
+export interface BroadcastSettings {
+  schemaVersion: 2
+  enabled: boolean
+  idleMs: number
+  minDelayMs: number
+  maxDelayMs: number
+  cooldownMs: number
+  cooldownMaxMs: number
+}
+
+export const DEFAULT_BROADCAST_SETTINGS: BroadcastSettings = {
+  // First beat: 90–180 seconds. Later beats: 180–480 seconds.
+  schemaVersion: 2, enabled: false, idleMs: 90_000, minDelayMs: 0, maxDelayMs: 90_000, cooldownMs: 180_000, cooldownMaxMs: 480_000,
+}
+
+export interface BroadcastDirectorDeps {
+  isSafeToBroadcast: () => boolean
+  produce: () => Promise<string | null>
+  /** Returns false when the candidate was not actually delivered as audio. */
+  speak: (text: string) => Promise<boolean | void>
+  now?: () => number
+  random?: () => number
+  cancel?: (reason: string) => void
+  onState?: (state: BroadcastDirectorState) => void
+  /** Content-free diagnostic hook; the rejected candidate itself is never exposed. */
+  onCandidateRejected?: () => void
+}
+
+const STORAGE_KEY = 'airi.local-proactive-broadcast.v1'
+export const BROADCAST_SETTINGS_CHANNEL_NAME = 'airi:local-proactive-broadcast:settings'
+export type BroadcastSettingsChannelEvent
+  = | { type: 'settings-changed', settings: BroadcastSettings }
+    | { type: 'user-activity' }
+const MAX_DELAY_MS = 24 * 60 * 60 * 1000
+const MIN_IDLE_MS = 90_000
+const MAX_FIRST_IDLE_MS = 180_000
+const MIN_COOLDOWN_MS = 180_000
+const MAX_COOLDOWN_MS = 480_000
+export const MAX_BROADCAST_CANDIDATE_CODE_POINTS = 60
+
+// Background narration must be independently speakable. A streamed/model
+// fragment is worse than silence, so this intentionally fails closed.
+const INCOMPLETE_BROADCAST_ENDING = /(?:\.{3}|…|[,;:：]|다니|지만|는데|으며|면서|도록|거나|니까|기에|다고(?:요)?|ㄴ데|은데|고|며|면|니)$/u
+const SAFE_KOREAN_BROADCAST_ENDING = /(?:다|요|죠|네|군|지|야|해|돼|줘|봐|있어|없어|같아|맞아|아냐)$/u
+const BROADCAST_TERMINAL_PUNCTUATION = /[.!?。！？]+$/u
+const BROADCAST_META = /(?:^|\n)\s*(?:\[\s*(?:user|assistant|system)\s*\]|(?:user|assistant|system)\s*:|user\s+input|stage\s+execution\s+plan|system\s+prompt|instructions?|conversation\s+example|example\s+(?:dialogue|conversation)|final\s+(?:contract\s+)?summary)\b/iu
+
+/** Whether text is a bounded, complete local proactive utterance. */
+export function isCompleteBroadcastCandidate(text: string): boolean {
+  const clean = text.trim()
+  if (!clean || [...clean].length > MAX_BROADCAST_CANDIDATE_CODE_POINTS || /[\r\n\u2028\u2029]/u.test(clean)) return false
+  if (BROADCAST_META.test(clean) || /<\|[\s\S]*?\|>|<[^>]+>/u.test(clean)) return false
+  if (INCOMPLETE_BROADCAST_ENDING.test(clean)) return false
+  return BROADCAST_TERMINAL_PUNCTUATION.test(clean) || SAFE_KOREAN_BROADCAST_ENDING.test(clean)
+}
+function validMs(value: unknown, fallback: number) {
+  return typeof value === 'number' && Number.isFinite(value) ? Math.max(0, Math.min(MAX_DELAY_MS, Math.floor(value))) : fallback
+}
+function clamp(value: number, minimum: number, maximum: number) {
+  return Math.max(minimum, Math.min(maximum, value))
+}
+export function normalizeBroadcastSettings(value: Partial<BroadcastSettings> | unknown): BroadcastSettings {
+  const input = value && typeof value === 'object' ? value as Partial<BroadcastSettings> : {}
+  const idleMs = clamp(validMs(input.idleMs, DEFAULT_BROADCAST_SETTINGS.idleMs), MIN_IDLE_MS, MAX_FIRST_IDLE_MS)
+  const maxJitterMs = MAX_FIRST_IDLE_MS - idleMs
+  const minDelayMs = clamp(validMs(input.minDelayMs, DEFAULT_BROADCAST_SETTINGS.minDelayMs), 0, maxJitterMs)
+  const maxDelayMs = Math.max(minDelayMs, clamp(validMs(input.maxDelayMs, DEFAULT_BROADCAST_SETTINGS.maxDelayMs), 0, maxJitterMs))
+  const cooldownMs = clamp(validMs(input.cooldownMs, DEFAULT_BROADCAST_SETTINGS.cooldownMs), MIN_COOLDOWN_MS, MAX_COOLDOWN_MS)
+  const cooldownMaxMs = Math.max(cooldownMs, clamp(validMs(input.cooldownMaxMs, DEFAULT_BROADCAST_SETTINGS.cooldownMaxMs), MIN_COOLDOWN_MS, MAX_COOLDOWN_MS))
+  return { schemaVersion: 2, enabled: input.enabled === true, idleMs, minDelayMs, maxDelayMs, cooldownMs, cooldownMaxMs }
+}
+function cryptoRandom() {
+  const values = new Uint32Array(1)
+  globalThis.crypto?.getRandomValues?.(values)
+  return values[0] / 0x1_0000_0000
+}
+function trigrams(text: string) {
+  const clean = text.toLocaleLowerCase().replace(/\s+/g, ' ').trim()
+  const out = new Set<string>()
+  for (let i = 0; i + 3 <= clean.length; i++) out.add(clean.slice(i, i + 3))
+  return out
+}
+
+/** Rejects blank/control-only/prompt meta and recently repeated candidate speech. */
+export function isBroadcastCandidate(text: string, recent: readonly string[]): boolean {
+  const clean = text.replace(/<\|[\s\S]*?\|>|<[^>]+>/g, '').trim()
+  if (!clean || clean.length < 2 || /^[\p{P}\p{S}\s]+$/u.test(clean) || !isCompleteBroadcastCandidate(clean)) return false
+  // Labels and examples are model-facing prompt structure, not spontaneous
+  // narration. Keep this structural so normal game/comic/chat vocabulary is
+  // never blocked just for containing a topic word.
+  if (/(?:^|\n)\s*(?:\[\s*(?:user|assistant|system|사용자|어시스턴트|시스템)\s*\]|(?:user|assistant|system|user\s+input|stage\s+execution\s+plan|question|final\s+(?:contract\s+)?summary|scenario|conversation\s+example|example\s+(?:dialogue|conversation)|instructions?)\s*:|(?:사용자|어시스턴트|시스템|질문|최종\s*계약?\s*요약|시나리오|대화\s*예시)\s*[:：])/iu.test(clean)) return false
+  if (/^\s*(?:\[\s*(?:user|assistant|system|사용자|어시스턴트|시스템)\s*\]|(?:user\s+input|stage\s+execution\s+plan|question|final\s+(?:contract\s+)?summary|scenario|conversation\s+example|example\s+(?:dialogue|conversation)|system\s+prompt|instructions?|질문|최종\s*계약?\s*요약|대화\s*예시|시나리오))(?:$|\s|[:：])/iu.test(clean)) return false
+  // Never surface renderer/protocol state as if it were a VTuber's
+  // spontaneous chat.  The model may see an empty-history prompt and echo a
+  // status label such as "새로운 사용자 입력"; reject it before TTS/UI.
+  if (/(?:사용자\s*:|아이리\s*:|대화\s*(?:예시|시작)|답변\s*예시|질문\s*예시|사용자\s*입력(?:\s*예시)?|새로운\s*(?:상황|대화|사용자\s*입력)|시나리오\s*시작|시작\s*대화|현재\s*대화\s*상황|최종\s*(?:질문|답변)\s*예시|요청\s*예시|주어진\s*상황|당신의\s*요청을\s*이해했습니다|사용자\s*입력(?:이|은)?\s*없|입력(?:을|이)\s*기다|대화(?:가|이)\s*없|시스템|프롬프트|모델\s*(?:이|은)?\s*대기|stage\s+execution\s+plan|new\s+user\s+interaction\s+start|new\s+user\s+input|no\s+user\s+input|waiting\s+for\s+(?:user\s+)?input|system\s+prompt)/iu.test(clean)) return false
+  // A proactive narrator must not announce work it could not have executed.
+  if (/\b(?:i\s+(?:ran|used|called|executed)|tool(?:\s+call)?\s+(?:completed|succeeded)|memory\s+(?:was\s+)?updated)\b|(?:도구|툴|메모리).{0,18}(?:실행|사용|완료|업데이트)|(?:실행|사용|완료|업데이트).{0,18}(?:도구|툴|메모리)/i.test(clean)) return false
+  const next = trigrams(clean)
+  return !recent.some((previous) => {
+    const prior = trigrams(previous)
+    if (!next.size || !prior.size) return clean === previous.trim()
+    let overlap = 0; next.forEach(part => { if (prior.has(part)) overlap++ })
+    return overlap / Math.min(next.size, prior.size) >= 0.65
+  })
+}
+
+export class LocalBroadcastDirector {
+  state: BroadcastDirectorState = 'disabled'
+  settings: BroadcastSettings
+  private timer: ReturnType<typeof setTimeout> | undefined
+  private recent: string[] = []
+  /** Invalidates stale timers and async generations after any user activity. */
+  private epoch = 0
+  constructor(private readonly deps: BroadcastDirectorDeps, settings?: Partial<BroadcastSettings>) {
+    this.settings = normalizeBroadcastSettings(settings)
+  }
+  private set(next: BroadcastDirectorState) { this.state = next; this.deps.onState?.(next) }
+  private clear() { if (this.timer) clearTimeout(this.timer); this.timer = undefined }
+  enable(enabled: boolean) { this.settings.enabled = enabled; if (!enabled) { this.epoch++; this.clear(); this.deps.cancel?.('broadcast-disabled'); this.set('disabled') } else this.activity() }
+  activity() {
+    const epoch = ++this.epoch
+    this.clear()
+    this.deps.cancel?.('user-activity')
+    if (!this.settings.enabled) return this.set('disabled')
+    this.set('waiting')
+    this.schedule(this.settings.idleMs, epoch, false)
+  }
+  /** Test trigger bypasses only the idle delay; safety gates remain mandatory. */
+  triggerForTest(): Promise<void> {
+    this.clear()
+    if (!this.settings.enabled) return Promise.resolve()
+    const epoch = ++this.epoch
+    return this.run(epoch, true)
+  }
+  private schedule(delay: number, epoch: number, skipRandomDelay: boolean) {
+    this.timer = setTimeout(() => { void this.run(epoch, skipRandomDelay) }, delay)
+  }
+  private async run(epoch: number, skipRandomDelay = false): Promise<void> {
+    if (epoch !== this.epoch) return
+    if (!this.settings.enabled) return this.set('disabled')
+    if (!this.deps.isSafeToBroadcast()) { this.set('waiting'); return this.schedule(this.settings.idleMs, epoch, false) }
+    this.set('armed')
+    const random = this.deps.random ?? cryptoRandom
+    const delay = this.settings.minDelayMs + Math.floor(random() * Math.max(0, this.settings.maxDelayMs - this.settings.minDelayMs))
+    // The jitter timer enters production on its next callback. Re-entering the
+    // jitter phase here would reschedule forever for every positive delay.
+    if (!skipRandomDelay && delay) { this.set('waiting'); this.schedule(delay, epoch, true); return }
+    this.set('producing')
+    let candidate: string | null
+    try {
+      candidate = await this.deps.produce()
+    }
+    catch {
+      // Cancellation, a local provider outage, or a rejected candidate is an
+      // expected fail-closed background path. Never leak an unhandled promise
+      // from an idle/test trigger.
+      if (epoch === this.epoch) this.activity()
+      return
+    }
+    if (epoch !== this.epoch) return
+    if (!this.settings.enabled || !this.deps.isSafeToBroadcast()) { this.activity(); return }
+    this.set('validating')
+    if (!candidate || !isBroadcastCandidate(candidate, this.recent)) {
+      this.deps.onCandidateRejected?.()
+      this.activity()
+      return
+    }
+    this.set('speaking')
+    let delivered = false
+    try { delivered = (await this.deps.speak(candidate)) !== false } catch { /* fail closed and re-arm below */ } finally {
+      if (delivered && epoch === this.epoch)
+        this.recent = [...this.recent.slice(-8), candidate]
+      if (epoch !== this.epoch)
+        return
+      if (!this.settings.enabled) this.set('disabled')
+      else {
+        this.set('cooldown')
+        if (!delivered) {
+          // A failed synthesis is not an invitation to retry narration every
+          // few seconds; re-enter the full idle window instead.
+          this.activity()
+          return
+        }
+        const random = this.deps.random ?? cryptoRandom
+        const cooldown = this.settings.cooldownMs + Math.floor(random() * Math.max(0, this.settings.cooldownMaxMs - this.settings.cooldownMs))
+        this.timer = setTimeout(() => {
+          if (epoch === this.epoch)
+            void this.run(epoch, true)
+        }, cooldown)
+      }
+    }
+  }
+}
+
+export function loadBroadcastSettings(storage: Storage | undefined = globalThis.localStorage): BroadcastSettings {
+  try {
+    const parsed = JSON.parse(storage?.getItem(STORAGE_KEY) || '{}') as Partial<BroadcastSettings>
+    // v1 used 5–10 second loops. Retain the user's opt-in choice, but never
+    // carry that unsafe cadence into the idle-only v2 policy.
+    if (parsed.schemaVersion !== 2)
+      return { ...DEFAULT_BROADCAST_SETTINGS, enabled: parsed.enabled === true }
+    return normalizeBroadcastSettings(parsed)
+  }
+  catch { return { ...DEFAULT_BROADCAST_SETTINGS } }
+}
+export function saveBroadcastSettings(settings: BroadcastSettings, storage: Storage | undefined = globalThis.localStorage) {
+  storage?.setItem(STORAGE_KEY, JSON.stringify(normalizeBroadcastSettings(settings)))
+}
