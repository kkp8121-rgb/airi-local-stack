+import { describe, expect, it } from 'vitest'
+
+import { pcmFloat32ToWavBlob } from './pcm-wav'
+
+describe('pcmFloat32ToWavBlob', () => {
+  it('writes a mono PCM16 WAV header and clamps Float32 samples', async () => {
+    const wav = pcmFloat32ToWavBlob(new Float32Array([-2, 0, 2]), 16000)
+    const bytes = new Uint8Array(await wav.arrayBuffer())
+    const view = new DataView(bytes.buffer)
+    const ascii = (start: number, length: number) => String.fromCharCode(...bytes.slice(start, start + length))
+
+    expect(wav.type).toBe('audio/wav')
+    expect(wav.size).toBe(50)
+    expect(ascii(0, 4)).toBe('RIFF')
+    expect(view.getUint32(4, true)).toBe(42)
+    expect(ascii(8, 4)).toBe('WAVE')
+    expect(ascii(12, 4)).toBe('fmt ')
+    expect(view.getUint32(16, true)).toBe(16)
+    expect(view.getUint16(20, true)).toBe(1)
+    expect(view.getUint32(24, true)).toBe(16000)
+    expect(view.getUint16(22, true)).toBe(1)
+    expect(view.getUint32(28, true)).toBe(32000)
+    expect(view.getUint16(32, true)).toBe(2)
+    expect(view.getUint16(34, true)).toBe(16)
+    expect(ascii(36, 4)).toBe('data')
+    expect(view.getUint32(40, true)).toBe(6)
+    expect(view.getInt16(44, true)).toBe(-32768)
+    expect(view.getInt16(46, true)).toBe(0)
+    expect(view.getInt16(48, true)).toBe(32767)
+  })
+
+  it('rejects an invalid sample rate', () => {
+    expect(() => pcmFloat32ToWavBlob(new Float32Array([0]), 0)).toThrow(/positive PCM sample rate/)
+  })
+})
diff --git a/packages/stage-ui/src/composables/audio/pcm-wav.ts b/packages/stage-ui/src/composables/audio/pcm-wav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..94b7abd929a0695ac48b6a80a093e854c516b7eb
--- /dev/null
+++ b/packages/stage-ui/src/composables/audio/pcm-wav.ts
@@ -0,0 +1,35 @@
+/** Converts mono Float32 PCM samples into a browser-playable PCM16 WAV blob. */
+export function pcmFloat32ToWavBlob(buffer: Float32Array, sampleRate: number): Blob {
+  if (!Number.isFinite(sampleRate) || sampleRate <= 0)
+    throw new Error('A positive PCM sample rate is required to create WAV audio.')
+
+  const bytesPerSample = 2
+  const dataSize = buffer.length * bytesPerSample
+  const wav = new ArrayBuffer(44 + dataSize)
+  const view = new DataView(wav)
+  const writeString = (offset: number, value: string) => {
+    for (let index = 0; index < value.length; index++)
+      view.setUint8(offset + index, value.charCodeAt(index))
+  }
+
+  writeString(0, 'RIFF')
+  view.setUint32(4, 36 + dataSize, true)
+  writeString(8, 'WAVE')
+  writeString(12, 'fmt ')
+  view.setUint32(16, 16, true)
+  view.setUint16(20, 1, true)
+  view.setUint16(22, 1, true)
+  view.setUint32(24, sampleRate, true)
+  view.setUint32(28, sampleRate * bytesPerSample, true)
+  view.setUint16(32, bytesPerSample, true)
+  view.setUint16(34, 16, true)
+  writeString(36, 'data')
+  view.setUint32(40, dataSize, true)
+
+  for (let index = 0; index < buffer.length; index++) {
+    const sample = Math.max(-1, Math.min(1, buffer[index]))
+    view.setInt16(44 + index * bytesPerSample, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true)
+  }
+
+  return new Blob([wav], { type: 'audio/wav' })
+}
