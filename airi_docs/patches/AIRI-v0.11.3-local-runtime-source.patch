+import { describe, expect, it, vi } from 'vitest'
+
+import { createAttemptTimeoutSignal } from './attempt-timeout'
+
+describe('createAttemptTimeoutSignal', () => {
+  it('aborts only the attempt when its timeout elapses', () => {
+    vi.useFakeTimers()
+    const parent = new AbortController()
+    const attempt = createAttemptTimeoutSignal(parent.signal, 10_000)
+
+    vi.advanceTimersByTime(10_000)
+
+    expect(attempt.signal.aborted).toBe(true)
+    expect(parent.signal.aborted).toBe(false)
+    attempt.cleanup()
+    vi.useRealTimers()
+  })
+
+  it('forwards parent cancellation to the attempt', () => {
+    const parent = new AbortController()
+    const attempt = createAttemptTimeoutSignal(parent.signal, 10_000)
+
+    parent.abort('intent-cancelled')
+
+    expect(attempt.signal.aborted).toBe(true)
+    expect(attempt.signal.reason).toBe('intent-cancelled')
+    attempt.cleanup()
+  })
+
+  it('cleans up its timer and parent listener after a completed attempt', () => {
+    vi.useFakeTimers()
+    const parent = new AbortController()
+    const attempt = createAttemptTimeoutSignal(parent.signal, 10_000)
+
+    attempt.cleanup()
+    parent.abort('after-cleanup')
+    vi.advanceTimersByTime(10_000)
+
+    expect(attempt.signal.aborted).toBe(false)
+    vi.useRealTimers()
+  })
+})
