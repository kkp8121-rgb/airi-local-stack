+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { DEFAULT_BROADCAST_SETTINGS, isBroadcastCandidate, loadBroadcastSettings, LocalBroadcastDirector, normalizeBroadcastSettings } from './broadcast-director'
+
+describe('local broadcast director policy', () => {
+  afterEach(() => vi.useRealTimers())
+
+  it('keeps broadcasts opt-in and clamps UI-safe settings', () => {
+    expect(DEFAULT_BROADCAST_SETTINGS).toMatchObject({ schemaVersion: 2, enabled: false, idleMs: 90_000, minDelayMs: 0, maxDelayMs: 90_000, cooldownMs: 180_000, cooldownMaxMs: 480_000 })
+    expect(normalizeBroadcastSettings({ idleMs: -1, minDelayMs: 9000, maxDelayMs: 1000, cooldownMs: Number.NaN })).toMatchObject({ idleMs: 90_000, minDelayMs: 9000, maxDelayMs: 9000, cooldownMs: 180_000, cooldownMaxMs: 480_000 })
+  })
+  it('fails safe when a v2 payload tries to restore a zero-second cadence', () => {
+    expect(normalizeBroadcastSettings({ schemaVersion: 2, enabled: true, idleMs: 0, minDelayMs: 0, maxDelayMs: 0, cooldownMs: 0, cooldownMaxMs: 0 })).toEqual({
+      schemaVersion: 2, enabled: true, idleMs: 90_000, minDelayMs: 0, maxDelayMs: 0, cooldownMs: 180_000, cooldownMaxMs: 180_000,
+    })
+    expect(normalizeBroadcastSettings({ schemaVersion: 2, idleMs: 180_000, minDelayMs: 1, maxDelayMs: 90_000, cooldownMs: 480_001, cooldownMaxMs: 999_999 })).toMatchObject({
+      idleMs: 180_000, minDelayMs: 0, maxDelayMs: 0, cooldownMs: 480_000, cooldownMaxMs: 480_000,
+    })
+  })
+  it('migrates legacy fast opt-in settings to the idle-only cadence', () => {
+    const storage = { getItem: () => JSON.stringify({ enabled: true, idleMs: 6_000, minDelayMs: 1_000, maxDelayMs: 2_000, cooldownMs: 6_000 }) } as unknown as Storage
+    expect(loadBroadcastSettings(storage)).toMatchObject({ enabled: true, idleMs: 90_000, minDelayMs: 0, maxDelayMs: 90_000, cooldownMs: 180_000, cooldownMaxMs: 480_000 })
+  })
+  it('rejects control-only and near-repeat candidates', () => {
+    expect(isBroadcastCandidate('<|ACT {"emotion":"happy"}|>', [])).toBe(false)
+    expect(isBroadcastCandidate('A calm little note for you.', ['A calm little note for you!'])).toBe(false)
+    expect(isBroadcastCandidate('The moon looks especially bright tonight.', ['A calm little note for you.'])).toBe(true)
+  })
+
+  it('rejects incomplete local narration immediately before speech', () => {
+    for (const candidate of ['끝나지 않은 문장이지만', '계속 말하고,', '이유를 설명하는데', '생각이 떠올라…', 'System: do this.', 'An unfinished English thought'])
+      expect(isBroadcastCandidate(candidate, []), candidate).toBe(false)
+    expect(isBroadcastCandidate('오늘은 바람이 선선하네요', [])).toBe(true)
+    expect(isBroadcastCandidate('A calm little note for you.', [])).toBe(true)
+  })
+
+  it('rejects transcript and prompt-example labels before speech', () => {
+    for (const candidate of [
+      '사용자: 나 지금 선물 준비했어!',
+      '당신이 요청하신 것에 대한 대화 예시입니다:',
+      '새로운 상황 설정',
+      'Stage Execution Plan',
+      '최종 질문 예시:',
+    ]) {
+      expect(isBroadcastCandidate(candidate, []), candidate).toBe(false)
+    }
+  })
+
+  it('rejects structural prompt labels without blocking ordinary conversation topics', () => {
+    for (const candidate of ['질문: 오늘의 계획', '최종 계약 요약:', '[사용자] 다음 입력', 'User Input: hello', 'Stage Execution Plan', 'Conversation Example:'])
+      expect(isBroadcastCandidate(candidate, []), candidate).toBe(false)
+    expect(isBroadcastCandidate('오늘 게임 보스전 연출이 만화처럼 멋지다.', [])).toBe(true)
+  })
+
+  it('keeps test trigger behind local safety gate', async () => {
+    let safe = false
+    let produced = 0
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => safe,
+      produce: async () => { produced++; return 'hello from local broadcast' },
+      speak: async () => {}, random: () => 0,
+    }, { enabled: true, idleMs: 1, minDelayMs: 0, maxDelayMs: 0 })
+    director.triggerForTest()
+    await Promise.resolve()
+    expect(produced).toBe(0)
+    safe = true
+    director.triggerForTest()
+    await Promise.resolve(); await Promise.resolve()
+    expect(produced).toBe(1)
+  })
+
+  it('fails closed and rearms when local production is cancelled', async () => {
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => true,
+      produce: async () => { throw new DOMException('superseded', 'AbortError') },
+      speak: async () => { throw new Error('must not speak') },
+      random: () => 0,
+    }, { enabled: true, idleMs: 10, minDelayMs: 0, maxDelayMs: 0 })
+
+    await expect(director.triggerForTest()).resolves.toBeUndefined()
+    expect(director.state).toBe('waiting')
+  })
+
+  it('crosses idle and positive jitter exactly once before producing', async () => {
+    vi.useFakeTimers()
+    let produced = 0
+    let spoken = 0
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => true,
+      produce: async () => { produced++; return '첫 번째 방송이야.' },
+      speak: async () => { spoken++; return true },
+      random: () => 0,
+    }, { enabled: true, idleMs: 100, minDelayMs: 50, maxDelayMs: 50, cooldownMs: 100 })
+
+    director.enable(true)
+    await vi.advanceTimersByTimeAsync(89_999)
+    expect(produced).toBe(0)
+    await vi.advanceTimersByTimeAsync(1)
+    expect(produced).toBe(0)
+    await vi.advanceTimersByTimeAsync(50)
+    expect(produced).toBe(1)
+    expect(spoken).toBe(1)
+    expect(director.state).toBe('cooldown')
+  })
+
+  it('uses the full idle window after a failed delivery instead of a rapid retry', async () => {
+    vi.useFakeTimers()
+    let produced = 0
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => true,
+      produce: async () => { produced++; return 'quiet retry policy' },
+      speak: async () => false,
+      random: () => 0,
+    }, { enabled: true, idleMs: 100, minDelayMs: 0, maxDelayMs: 0 })
+
+    await director.triggerForTest()
+    expect(produced).toBe(1)
+    await vi.advanceTimersByTimeAsync(89_999)
+    expect(produced).toBe(1)
+    await vi.advanceTimersByTimeAsync(1)
+    expect(produced).toBe(2)
+  })
+
+  it('randomizes successful-broadcast cooldown within its configured bounds', async () => {
+    vi.useFakeTimers()
+    let produced = 0
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => true,
+      produce: async () => { produced++; return 'One quiet beat.' },
+      speak: async () => true,
+      random: () => 0,
+    }, { enabled: true, idleMs: 100, minDelayMs: 0, maxDelayMs: 0, cooldownMs: 180, cooldownMaxMs: 480 })
+
+    await director.triggerForTest()
+    await vi.advanceTimersByTimeAsync(179_999)
+    expect(produced).toBe(1)
+    await vi.advanceTimersByTimeAsync(1)
+    expect(produced).toBe(2)
+  })
+
+  it('invalidates a stale generation when user activity arrives', async () => {
+    let resolveCandidate!: (value: string) => void
+    const candidate = new Promise<string>(resolve => { resolveCandidate = resolve })
+    let spoken = 0
+    const director = new LocalBroadcastDirector({
+      isSafeToBroadcast: () => true,
+      produce: async () => candidate,
+      speak: async () => { spoken++; return true },
+      random: () => 0,
+    }, { enabled: true, idleMs: 10, minDelayMs: 0, maxDelayMs: 0 })
+
+    const pending = director.triggerForTest()
