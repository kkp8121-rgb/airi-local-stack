+const MAX_CORRELATION_ID_LENGTH = 128
+const CORRELATION_ID_RE = /^[A-Za-z0-9._:-]+$/
+
+/** Correlation headers are only attached to loopback STT endpoints. */
+function withLocalTranscriptionRoundId<T extends { baseURL?: unknown, headers?: HeadersInit }>(request: T, roundId?: string): T {
+  const normalizedRoundId = roundId?.trim()
+  if (!normalizedRoundId
+    || normalizedRoundId.length > MAX_CORRELATION_ID_LENGTH
+    || !CORRELATION_ID_RE.test(normalizedRoundId))
+    return request
+
+  let target: URL
+  try {
+    target = request.baseURL instanceof URL
+      ? request.baseURL
+      : new URL(String(request.baseURL))
+  }
+  catch {
+    return request
+  }
+
+  const hostname = target.hostname.toLowerCase()
+  if (hostname !== 'localhost' && hostname !== '127.0.0.1' && hostname !== '[::1]' && hostname !== '::1')
+    return request
+
+  const headers = new Headers(request.headers)
+  headers.set(AIRI_CHAT_ROUND_ID_HEADER, normalizedRoundId)
+  return { ...request, headers }
 }
 
