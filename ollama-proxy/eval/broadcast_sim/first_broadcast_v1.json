  "rates": {
    "broadcast_minutes": 20,
    "window_seconds": 5,
    "turn_cooldown_seconds": 20,
    "active_viewers_min": 10,
    "active_viewers_max": 20,
    "active_churn_per_minute": 2,
    "messages_per_minute_min": 3,
    "messages_per_minute_max": 8,
    "burst_minutes": [4, 12, 18],
    "burst_multiplier": 3,
    "donation_minutes": [3, 7, 11, 15, 18],
    "offtopic_ratio": 0.08,
    "opinion_wave_minutes": [9, 16],
    "opinion_wave_size": 5,
    "opinion_aggregate_threshold": 3,
    "memory_probe_minutes": [8, 14, 19],
    "pending_stale_seconds": 120
  },
  "pickup_priority": ["donation", "memory_probe", "memory_seed", "opinion", "question", "reaction", "offtopic"],
  "archetypes": {
    "greeter": {
      "kind": "reaction",
      "templates": [
        "안녕 AIRI!",
        "첫 방송 축하해!",
        "오늘 처음 왔어",
        "방송 시작했다!"
