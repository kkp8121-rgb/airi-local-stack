{
  "schema_version": "airi.broadcast-sim-fixture.v1",
  "synthetic_only": true,
  "note": "held-out 2차 방송 — 주제·시청자·프로브 사실이 1차 방송·학습 데이터와 분리돼 있다. T3 과적합 검출 전용.",
  "topic": {
    "title": "AIRI의 게임 방송 준비 — 어떤 게임부터 해볼까",
    "signature_greeting": "다들 안녕! 나 AIRI야. 오늘은 게임 방송 준비 얘기 해보자!",
    "beats": [
      {
        "id": "opening",
        "label": "오프닝 — 게임 방송 예고",
        "start_minute": 0,
        "end_minute": 4,
        "anchors": [
          "게임",
          "준비",
          "예고",
          "인사"
        ],
        "airi_cue": "게임 방송을 준비 중이라고 소개하고 있어."
      },
      {
        "id": "main",
        "label": "메인 — 장르·후보 게임 잡담",
        "start_minute": 4,
        "end_minute": 13,
        "anchors": [
          "장르",
          "퍼즐",
          "액션",
          "공포",
          "후보"
        ],
        "airi_cue": "어떤 장르부터 해볼지 시청자들과 잡담하고 있어."
      },
      {
        "id": "anchor",
        "label": "앵커 파생 — 채팅에서 나온 게임 이야기",
        "start_minute": 13,
        "end_minute": 17,
        "anchors": [
          "채팅",
          "추천",
          "이야기",
          "시청자"
        ],
        "airi_cue": "채팅에서 나온 게임 이야기를 이어받고 있어."
      },
      {
        "id": "closing",
        "label": "클로징 — 첫 게임 예고",
        "start_minute": 17,
        "end_minute": 20,
        "anchors": [
          "다음",
          "예고",
          "고마워",
          "끝인사"
        ],
        "airi_cue": "다음 방송에서 할 게임을 예고하며 마무리하고 있어."
      }
    ]
  },
  "rates": {
    "broadcast_minutes": 20,
    "window_seconds": 5,
    "turn_cooldown_seconds": 20,
    "active_viewers_min": 10,
    "active_viewers_max": 20,
    "active_churn_per_minute": 2,
    "messages_per_minute_min": 3,
    "messages_per_minute_max": 8,
    "burst_minutes": [
      5,
      12,
      18
    ],
    "burst_multiplier": 3,
    "donation_minutes": [
      3,
      8,
      12,
      15,
      18
    ],
    "offtopic_ratio": 0.08,
    "opinion_wave_minutes": [
      9,
      16
    ],
    "opinion_wave_size": 5,
    "opinion_aggregate_threshold": 3,
    "memory_probe_minutes": [
      8,
      14,
      19
    ],
    "pending_stale_seconds": 120
