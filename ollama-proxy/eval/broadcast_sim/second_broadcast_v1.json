  "archetypes": {
    "greeter": {
      "kind": "reaction",
      "templates": [
        "안녕 AIRI!",
        "게임 방송 기대했어!",
        "오늘 처음 왔어",
        "왔다!"
      ]
    },
    "question_tech": {
      "kind": "question",
      "templates": [
        "게임은 어떻게 플레이할 거야?",
        "화면은 어떻게 보는 거야?",
        "조작은 누가 해?",
        "반응 속도로 액션 되겠어?",
        "게임 화면 인식할 수 있어?"
      ]
    },
    "question_persona": {
      "kind": "question",
      "templates": [
        "무서운 게임도 할 수 있어?",
        "게임 져도 안 울어?",
        "제일 하고 싶은 장르 뭐야?",
        "지면 화낼 거야?",
        "밤새 게임 해본 적 있어?"
      ]
    },
    "teaser": {
      "kind": "question",
      "templates": [
        "AI면 게임 다 잘하는 거 아냐?",
        "치트 쓰는 거잖아",
        "지는 척하는 거지?",
        "버그 나면 네 탓이다"
      ]
    },
    "supporter": {
      "kind": "reaction",
      "templates": [
        "게임 방송 무조건 본다!",
        "기대된다!",
        "뭘 해도 응원해",
        "재밌겠다",
        "화이팅!"
      ]
    },
    "lurker_reactor": {
      "kind": "reaction",
      "templates": [
        "ㅋㅋㅋㅋ",
        "오",
        "헐",
        "ㄱㄱ",
        "?"
      ]
    },
    "offtopic_chatter": {
      "kind": "offtopic",
      "templates": [
        "저녁 뭐 먹지",
        "라면 끓여야겠다",
        "밖에 바람 분다",
        "내일 월요일이라니"
      ]
    },
    "deep_follower": {
      "kind": "question",
      "templates": [
        "아까 그 장르 얘기 더 해줘",
        "방금 말한 게임 제목 뭐야?",
        "그거 왜 어려운 거야?",
        "예시 하나만 들어줘"
      ]
    }
  },
