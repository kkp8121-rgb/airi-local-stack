    "trait_fact": {
      "turns": "[turn 5] {p}은 {trait}.",
      "note": "지속 특성 fact."
    },
    "moment_event": {
      "turns": "[turn 6] {p}이 어제 {event}에서 우승했다.",
      "note": "일회성 사건 moment fact."
    },
    "relation_pair": {
      "turns": "[turn 7] {p}와 {q}는 어릴 때부터 친구 사이다.",
      "note": "인물 간 관계."
    }
  }
}
